      "sql": "WITH made AS (\n  SELECT i, uuidv7() AS v7, gen_random_uuid() AS v4\n  FROM generate_series(1, 1000) AS i\n)\nSELECT bool_and(v7 > prev_v7) AS v7_always_increasing,\n       bool_and(v4 > prev_v4) AS v4_always_increasing\nFROM (\n  SELECT v7, v4, lag(v7) OVER (ORDER BY i) AS prev_v7, lag(v4) OVER (ORDER BY i) AS prev_v4\n  FROM made\n) AS pairs\nWHERE prev_v7 IS NOT NULL;",
