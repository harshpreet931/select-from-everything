   "session": "T1",
   "sql": "SELECT t.type, t.value, t.bytes\nFROM (VALUES (1, 'json', '{\"b\": 1,   \"a\": 2, \"a\": 3}'::json::text, pg_column_size('{\"b\": 1,   \"a\": 2, \"a\": 3}'::json)),\n             (2, 'jsonb', '{\"b\": 1,   \"a\": 2, \"a\": 3}'::jsonb::text, pg_column_size('{\"b\": 1,   \"a\": 2, \"a\": 3}'::jsonb))) AS t (n, type, value, bytes)\nORDER BY t.n",
   "note": "one piece of text, stored as json and as jsonb: json keeps the text, jsonb keeps the meaning.",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 2,
    "columns": [{"name":"type","type":"text"},{"name":"value","type":"text"},{"name":"bytes","type":"int4"}],
    "data": [["json","{\"b\": 1,   \"a\": 2, \"a\": 3}","30"],["jsonb","{\"a\": 3, \"b\": 1}","44"]]
   }
