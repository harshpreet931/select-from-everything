  {
   "i": 6,
   "session": "T1",
   "sql": "SELECT p.id, t.tag, t.pos\nFROM products AS p\nCROSS JOIN LATERAL unnest(p.tags) WITH ORDINALITY AS t (tag, pos)\nWHERE p.id IN (1, 3, 5, 7)\nORDER BY p.id, t.pos",
   "note": "unnest turns each element into a row. WITH ORDINALITY numbers them. product 3's empty array makes no rows at all.",
   "status": "ok",
   "result": {
