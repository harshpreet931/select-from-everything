  {
   "i": 5,
   "session": "T1",
   "sql": "SET TimeZone = 'Europe/Paris';\nSELECT w AS typed, w::timestamptz AS stored, w::timestamptz AT TIME ZONE 'UTC' AS in_utc\nFROM (VALUES ('2026-03-29 01:30'), ('2026-03-29 02:00'), ('2026-03-29 02:30'), ('2026-03-29 03:00'), ('2026-03-29 03:30')) AS v (w)\nORDER BY w",
   "note": "paris wall-clock times typed in on the morning of the change. 02:00 and 02:30 never happened there.",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 5,
