  {
   "i": 0,
   "session": "T1",
   "sql": "SET TimeZone = 'UTC';\nSELECT created_at FROM customers WHERE id = 12",
   "note": "with TimeZone = UTC, the instant prints as itself.",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 1,
    "columns": [{"name":"created_at","type":"timestamptz"}],
    "data": [["2026-03-29 01:30:00+00"]]
   }
  },
  {
   "i": 1,
   "session": "T1",
   "sql": "SET TimeZone = 'Asia/Kolkata';\nSELECT created_at FROM customers WHERE id = 12",
   "note": "the same stored value, printed for india: five and a half hours later on the clock.",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 1,
    "columns": [{"name":"created_at","type":"timestamptz"}],
    "data": [["2026-03-29 07:00:00+05:30"]]
   }
  },
  {
   "i": 2,
   "session": "T1",
   "sql": "SET TimeZone = 'Europe/Paris';\nSELECT created_at FROM customers WHERE id = 12",
   "note": "printed for paris: it's 03:30, half an hour after the clocks jumped from 02:00 to 03:00.",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 1,
    "columns": [{"name":"created_at","type":"timestamptz"}],
    "data": [["2026-03-29 03:30:00+02"]]
