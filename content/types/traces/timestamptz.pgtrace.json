  },
  {
   "i": 4,
   "session": "T1",
   "sql": "SET TimeZone = 'UTC';\nSELECT z.zone, t AS utc, to_char(t AT TIME ZONE z.zone, 'HH24:MI') AS wall\nFROM (VALUES (1, 'UTC'), (2, 'Asia/Kolkata'), (3, 'Europe/Paris'), (4, 'America/New_York')) AS z (n, zone)\nCROSS JOIN generate_series(timestamptz '2026-03-28 21:00+00', timestamptz '2026-03-29 05:00+00', interval '1 hour') AS t\nORDER BY z.n, t",
   "note": "hourly instants around the signup, and the wall clock each zone shows at each one.",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 36,
    "columns": [{"name":"zone","type":"text"},{"name":"utc","type":"timestamptz"},{"name":"wall","type":"text"}],
    "data": [
