  },
  {
   "i": 3,
   "session": "T1",
   "sql": "SET TimeZone = 'America/New_York';\nSELECT created_at FROM customers WHERE id = 12",
   "note": "printed for new york: still the evening before.",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 1,
    "columns": [{"name":"created_at","type":"timestamptz"}],
    "data": [["2026-03-28 21:30:00-04"]]
