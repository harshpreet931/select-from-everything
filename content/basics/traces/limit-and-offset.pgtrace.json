 "steps": [
  {
   "i": 0,
   "session": "T1",
   "sql": "SELECT id, name, year\nFROM students\nLIMIT 3",
   "note": "no ORDER BY: postgres reads the table front to back and stops after three. today that's students 1, 2 and 3.",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 3,
    "columns": [{"name":"id","type":"int4"},{"name":"name","type":"text"},{"name":"year","type":"int2"}],
    "data": [["1","Maya Chen","4"],["2","Liam Walsh","3"],["3","Aisha Bello","2"]]
   }
  },
  {
   "i": 1,
   "session": "T1",
   "sql": "UPDATE students SET year = year WHERE id = 1;\nSELECT id, name, year\nFROM students\nLIMIT 3",
   "note": "one UPDATE that changes nothing you can see writes a new version of student 1 at the end of the page. the same LIMIT 3 now starts at student 2.",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 3,
    "columns": [{"name":"id","type":"int4"},{"name":"name","type":"text"},{"name":"year","type":"int2"}],
    "data": [["2","Liam Walsh","3"],["3","Aisha Bello","2"],["4","Noah Schmidt","1"]]
   }
  },
  {
   "i": 2,
   "session": "T1",
   "sql": "SELECT code, credits, title\nFROM courses\nORDER BY credits DESC\nFETCH FIRST 3 ROWS WITH TIES",
   "note": "asked for 3, got 9",
   "status": "ok",
   "stages": [
