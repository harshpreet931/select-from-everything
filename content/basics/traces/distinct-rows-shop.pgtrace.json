  {
   "i": 0,
   "session": "T1",
   "sql": "SELECT DISTINCT name\nFROM customers\nWHERE id <= 12\nORDER BY name",
   "note": "by name: the two Sam Lees are one row, though they're two people. Zoë and Zoe Martin stay apart: ë isn't e.",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 11,
    "columns": [{"name":"name","type":"text"}],
    "data": [
