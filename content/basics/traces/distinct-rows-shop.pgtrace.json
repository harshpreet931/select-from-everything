   }
  },
  {
   "i": 1,
   "session": "T1",
   "sql": "SELECT DISTINCT name, city\nFROM customers\nWHERE id <= 12\nORDER BY name, city",
   "note": "by name and city: Toronto's Sam and Seoul's Sam are different rows again. a whole row has to match to be a duplicate.",
