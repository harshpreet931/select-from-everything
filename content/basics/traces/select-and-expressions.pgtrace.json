    "data": [
     ["chef's knife","58.800","KITCHEN","f","EUR"],
     ["studio headphones","155.988","AUDIO","t","EUR"],
     ["wooden train","28.800",null,"f","EUR"],
     ["left-handed teapot","23.988","KITCHEN","f","EUR"]
    ]
   }
  },
  {
   "i": 2,
   "session": "T1",
   "sql": "SELECT 7 / 2 AS result, pg_typeof(7 / 2) AS type",
   "note": "two integers make an integer, and integer division throws the remainder away: 3, not 3.5.",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 1,
    "columns": [{"name":"result","type":"int4"},{"name":"type","type":"regtype"}],
    "data": [["3","integer"]]
   }
  },
  {
   "i": 3,
   "session": "T1",
   "sql": "SELECT 7 / 2.0 AS result, pg_typeof(7 / 2.0) AS type",
   "note": "2.0 is a numeric, so the division is numeric too, and keeps its decimals.",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 1,
    "columns": [{"name":"result","type":"numeric"},{"name":"type","type":"regtype"}],
    "data": [["3.5000000000000000","numeric"]]
   }
  },
  {
   "i": 4,
   "session": "T1",
   "sql": "SELECT 7::numeric / 2 AS result, pg_typeof(7::numeric / 2) AS type",
   "note": "casting one side is enough: numeric divided by integer is numeric.",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 1,
    "columns": [{"name":"result","type":"numeric"},{"name":"type","type":"regtype"}],
    "data": [["3.5000000000000000","numeric"]]
   }
  },
  {
   "i": 5,
   "session": "T1",
   "sql": "SELECT 7::float8 / 2 AS result, pg_typeof(7::float8 / 2) AS type",
