  {
   "i": 1,
   "session": "T1",
   "sql": "SELECT name, price * 1.2 AS gross, upper(category) AS shelf, price > 50 AS pricey, 'EUR' AS currency\nFROM products\nWHERE id IN (1, 5, 7, 200)\nORDER BY id",
   "note": "what SELECT hands on: one output row per input row, one column per item in the list.",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 4,
    "columns": [
     {"name":"name","type":"text"},
     {"name":"gross","type":"numeric"},
     {"name":"shelf","type":"text"},
     {"name":"pricey","type":"bool"},
