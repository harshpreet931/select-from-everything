  {
   "i": 0,
   "session": "T1",
   "sql": "SELECT code, title\nFROM courses\nWHERE credits = 4 AND dept <> 'CS'\nORDER BY code",
   "note": "4-credit courses outside CS",
   "status": "ok",
   "stages": [
    {
     "clause": "FROM",
     "note": "FROM hands over all 12 courses, drawn with the three that will survive on top, so you can watch the other 9 go.",
     "sql": "SELECT code, dept, credits, title FROM courses ORDER BY (credits = 4 AND dept <> 'CS') DESC, code",
     "columns": ["code","dept","credits","title"],
     "types": ["text","text","int2","text"],
     "data": [
      ["MATH101","MATH","4","Calculus I"],
      ["PHYS101","PHYS","4","Mechanics"],
      ["PHYS201","PHYS","4","Electromagnetism"],
      ["CS101","CS","4","Intro to Programming"],
      ["CS201","CS","4","Data Structures"],
      ["CS301","CS","4","Databases"],
      ["CS350","CS","4","Operating Systems"],
      ["CS401","CS","4","Database Internals"],
      ["CS499","GEN","6","Senior Thesis"],
      ["HIST101","HIST","3","History of Computing"],
      ["MATH201","MATH","3","Discrete Math"],
      ["MATH301","MATH","3","Linear Algebra"]
     ]
    },
    {
     "clause": "WHERE",
     "note": "WHERE asks every row the same question, on its own: 4 credits, and not CS? 3 rows say true. the five CS courses pass the first test and fail the second, and they're as gone as the 3-credit ones.",
     "sql": "SELECT code, dept, credits, title FROM courses WHERE credits = 4 AND dept <> 'CS' ORDER BY code",
     "columns": ["code","dept","credits","title"],
     "types": ["text","text","int2","text"],
     "data": [
      ["MATH101","MATH","4","Calculus I"],
      ["PHYS101","PHYS","4","Mechanics"],
      ["PHYS201","PHYS","4","Electromagnetism"]
     ]
    },
    {
     "clause": "SELECT",
     "note": "SELECT keeps the two columns asked for. dept and credits did their job in WHERE, and don't have to be in the output.",
     "sql": "SELECT code, title FROM courses WHERE credits = 4 AND dept <> 'CS' ORDER BY code",
     "columns": ["code","title"],
     "types": ["text","text"],
     "data": [["MATH101","Calculus I"],["PHYS101","Mechanics"],["PHYS201","Electromagnetism"]]
    }
   ],
   "result": {
    "command": "SELECT",
    "rows": 3,
    "columns": [{"name":"code","type":"text"},{"name":"title","type":"text"}],
    "data": [["MATH101","Calculus I"],["PHYS101","Mechanics"],["PHYS201","Electromagnetism"]]
   }
  },
