   "session": "T1",
   "sql": "SELECT c.name, count(*) AS orders\nFROM customers AS c\nJOIN orders AS o ON o.customer_id = c.id\nWHERE c.name IN ('Sam Lee', 'Ada Lovelace')\nGROUP BY c.name\nORDER BY c.name",
   "note": "grouped by name, the two Sam Lees fall into one bucket: 37 orders, and no way to tell whose.",
   "status": "ok",
   "result": {
