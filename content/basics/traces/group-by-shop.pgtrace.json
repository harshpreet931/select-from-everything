  {
   "i": 0,
   "session": "T1",
   "sql": "SELECT date_trunc('month', ordered_at)::date AS month, count(*) AS orders\nFROM orders\nGROUP BY date_trunc('month', ordered_at)\nORDER BY month",
   "note": "orders per month: the bucket key is an expression, date_trunc('month', ordered_at).",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 12,
