 "setup": "",
 "steps": [
  {
   "i": 0,
   "session": "T1",
   "sql": "SELECT id, name, price,\n       CASE WHEN price = 0 THEN 'free'\n            WHEN price < 25 THEN 'under 25'\n            WHEN price < 100 THEN 'under 100'\n            ELSE '100 and up'\n       END AS band,\n       CASE WHEN price = 0 THEN 0 WHEN price < 25 THEN 1 WHEN price < 100 THEN 2 ELSE 3 END AS rung\nFROM products\nWHERE id IN (4, 200, 1, 8, 5)\nORDER BY price",
   "note": "five products through a price ladder.",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 5,
    "columns": [
     {"name":"id","type":"int4"},
     {"name":"name","type":"text"},
     {"name":"price","type":"numeric"},
     {"name":"band","type":"text"},
     {"name":"rung","type":"int4"}
    ],
    "data": [
     ["4","paper clips, free sample","0.00","free","0"],
     ["200","left-handed teapot","19.99","under 25","1"],
     ["1","chef's knife","49.00","under 100","2"],
     ["8","cat tree","89.00","under 100","2"],
     ["5","studio headphones","129.99","100 and up","3"]
    ]
   }
  },
  {
   "i": 1,
   "session": "T1",
   "sql": "SELECT id, name, city, email,\n       coalesce(city, email, 'nothing on file') AS reach,\n       CASE WHEN city IS NOT NULL THEN 0 WHEN email IS NOT NULL THEN 1 ELSE 2 END AS rung\nFROM customers\nWHERE id IN (42, 6, 11)\nORDER BY id DESC",
   "note": "three customers through coalesce(city, email, 'nothing on file').",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 3,
    "columns": [
     {"name":"id","type":"int4"},
     {"name":"name","type":"text"},
     {"name":"city","type":"text"},
     {"name":"email","type":"text"},
     {"name":"reach","type":"text"},
     {"name":"rung","type":"int4"}
    ],
    "data": [
     ["42","Ada Lovelace","London","ada@example.com","London","0"],
     ["11","Ana Lima","",null,"","0"],
     ["6","José Silva",null,"jose.silva@example.com","jose.silva@example.com","1"]
    ]
   }
  },
  {
   "i": 2,
   "session": "T1",
   "sql": "SELECT status, count(*) AS orders\nFROM orders\nGROUP BY status\nORDER BY status",
   "note": "sorted by the text: alphabetical, which is nobody's idea of an order's life.",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 6,
    "columns": [{"name":"status","type":"text"},{"name":"orders","type":"int8"}],
