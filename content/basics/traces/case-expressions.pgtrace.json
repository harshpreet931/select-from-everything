  {
   "i": 3,
   "session": "T1",
   "sql": "SELECT status, count(*) AS orders\nFROM orders\nGROUP BY status\nORDER BY CASE status\n           WHEN 'placed' THEN 1\n           WHEN 'paid' THEN 2\n           WHEN 'shipped' THEN 3\n           WHEN 'delivered' THEN 4\n           ELSE 5\n         END,\n         status",
   "note": "sorted by a CASE that numbers the statuses in the order an order lives them.",
