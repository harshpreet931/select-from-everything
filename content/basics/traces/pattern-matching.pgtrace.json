   "sql": "SELECT name,\n       name LIKE 'S%' AS \"s%\",\n       name LIKE '%Lee' AS \"%lee\",\n       name LIKE 'Zo_ Martin' AS \"zo_\",\n       name LIKE 'a%' AS \"a%\",\n       name ILIKE 'a%' AS \"ilike a%\",\n       name LIKE '%''%' AS \"quote\",\n       name ~* 'lee|lima' AS \"regex\"\nFROM customers\nWHERE id IN (42, 3, 8, 4, 5, 10, 11)\nORDER BY id",
   "note": "the grid: each name against LIKE, ILIKE and a regular expression.",
