      "sql": "CREATE TABLE ev_k (LIKE events INCLUDING DEFAULTS) PARTITION BY LIST (kind);\nCREATE TABLE ev_k_browse PARTITION OF ev_k FOR VALUES IN ('view', 'click');\nCREATE TABLE ev_k_buy    PARTITION OF ev_k FOR VALUES IN ('add_to_cart', 'purchase');\nCREATE TABLE ev_k_signup PARTITION OF ev_k FOR VALUES IN ('signup');\nINSERT INTO ev_k SELECT * FROM events ORDER BY id;\nANALYZE ev_k;\nSELECT tableoid::regclass AS partition, kind, count(*) FROM ev_k GROUP BY tableoid, kind ORDER BY partition, kind;",
