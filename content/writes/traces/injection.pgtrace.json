     ["select","select","\"select\"","'select'"],
     [
      "x\"; DROP TABLE orders; --",
      "x\"; DROP TABLE orders; --",
      "\"x\"\"; DROP TABLE orders; --\"",
      "'x\"; DROP TABLE orders; --'"
