 "steps": [
  {
   "i": 0,
   "session": "T1",
   "sql": "SELECT count(*) AS rows FROM (\nSELECT id, name FROM customers WHERE email = 'ada@example.com' ORDER BY id\n) AS app_query",
   "note": "glued, with an ordinary email: one row, Ada.",
   "status": "ok",
   "result": {"command":"SELECT","rows":1,"columns":[{"name":"rows","type":"int8"}],"data":[["1"]]}
  },
  {
   "i": 1,
   "session": "T1",
   "sql": "SELECT count(*) AS rows FROM (\nSELECT id, name FROM customers WHERE email = '' OR 1=1 --' ORDER BY id\n) AS app_query",
   "note": "glued, with ' OR 1=1 --: the quote closes the string, OR 1=1 is true for every row, and -- turns the rest into a comment. every customer.",
   "status": "ok",
   "result": {"command":"SELECT","rows":1,"columns":[{"name":"rows","type":"int8"}],"data":[["2000"]]}
  },
  {
   "i": 2,
   "session": "T1",
   "sql": "SELECT id, name FROM customers WHERE email = ''; DROP TABLE customers; --' ORDER BY id",
   "note": "glued, with '; DROP TABLE customers; --: two statements. the first finds nobody, then DROP TABLE runs, and fails only because orders still points at customers.",
   "status": "error",
   "error": {
    "sqlstate": "2BP01",
    "message": "cannot drop table customers because other objects depend on it",
    "detail": "constraint orders_customer_id_fkey on table orders depends on table customers"
   }
  },
  {
   "i": 3,
   "session": "T1",
   "sql": "PREPARE login(text) AS\nSELECT id, name FROM customers WHERE email = $1 ORDER BY id",
   "note": "the bound version: the sql is fixed, and $1 is a slot for one text value.",
   "status": "ok",
   "result": {"command":"PREPARE","rows":null,"columns":[],"data":[]}
  },
  {
   "i": 4,
   "session": "T1",
   "sql": "EXECUTE login('ada@example.com')",
   "note": "bound, with an ordinary email: one row, Ada.",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 1,
    "columns": [{"name":"id","type":"int4"},{"name":"name","type":"text"}],
    "data": [["42","Ada Lovelace"]]
   }
  },
  {
   "i": 5,
   "session": "T1",
   "sql": "EXECUTE login(''' OR 1=1 --')",
   "note": "bound, with ' OR 1=1 --: nobody's email is literally that, so no rows.",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 0,
    "columns": [{"name":"id","type":"int4"},{"name":"name","type":"text"}],
    "data": []
   }
  },
  {
   "i": 6,
   "session": "T1",
   "sql": "EXECUTE login('''; DROP TABLE customers; --')",
   "note": "bound, with '; DROP TABLE customers; --: still just an odd email address. no rows, nothing dropped.",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 0,
    "columns": [{"name":"id","type":"int4"},{"name":"name","type":"text"}],
    "data": []
   }
  },
  {
   "i": 7,
   "session": "T1",
   "sql": "SELECT input,\n       format('%s', input) AS \"%s\",\n       format('%I', input) AS \"%I\",\n       format('%L', input) AS \"%L\"\nFROM (VALUES (1, 'customers'), (2, 'Customers'), (3, 'order items'), (4, 'select'),\n             (5, 'x\"; DROP TABLE orders; --'), (6, 'O''Neil')) AS t (n, input)\nORDER BY n",
   "note": "identifiers can't be parameters, so they get quoted instead. %s pastes text as is, %I quotes it as an identifier when it needs quoting, %L as a literal.",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 6,
    "columns": [
     {"name":"input","type":"text"},
     {"name":"%s","type":"text"},
     {"name":"%I","type":"text"},
