     {"name":"new_sku","type":"text"},
     {"name":"new_price","type":"numeric"}
    ],
    "data": [["UPDATE","BOO-0028","16.90","BOO-0028","17.50"],["INSERT",null,null,"BOO-0203","21.00"]]
