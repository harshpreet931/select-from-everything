   "i": 10,
   "session": "T1",
   "sql": "MERGE INTO products AS p\nUSING (VALUES ('BOO-0028', 17.50, 'bamboo cookbook'),\n              ('BOO-0203', 21.00, 'joins for cats')) AS f (sku, price, name)\nON p.sku = f.sku\nWHEN MATCHED THEN UPDATE SET price = f.price\nWHEN NOT MATCHED THEN INSERT (sku, name, category, price)\n                      VALUES (f.sku, f.name, 'books', f.price)\nRETURNING merge_action() AS action,\n          old.sku AS old_sku, old.price AS old_price,\n          new.sku AS new_sku, new.price AS new_price",
   "note": "MERGE: one statement, two kinds of write. merge_action() says which, and old and new follow the same rules row by row.",
   "status": "ok",
   "result": {
    "command": "MERGE",
    "rows": 2,
    "columns": [
     {"name":"action","type":"text"},
     {"name":"old_sku","type":"text"},
