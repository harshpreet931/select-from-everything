   "sql": "INSERT INTO products (sku, name, category, price)\nVALUES ('BOO-0201', 'the sql cookbook', 'books', 24.00)\nRETURNING old.sku AS old_sku, old.price AS old_price,\n          new.sku AS new_sku, new.price AS new_price",
