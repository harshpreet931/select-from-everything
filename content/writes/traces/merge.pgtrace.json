  {
   "i": 2,
   "session": "T1",
   "sql": "BEGIN",
   "note": "a transaction, so each variant starts from the same books.",
   "status": "ok",
   "result": {"command":"BEGIN","rows":null,"columns":[],"data":[]}
  },
  {
   "i": 3,
   "session": "T1",
   "sql": "MERGE INTO products AS p\nUSING feed AS f ON p.sku = f.sku\nWHEN MATCHED AND p.price <> f.price THEN\n  UPDATE SET price = f.price\nRETURNING merge_action() AS action, p.sku, old.price AS old_price, new.price AS new_price, p.discontinued",
   "note": "only WHEN MATCHED: the two books whose price changed are updated. everything else is left alone.",
   "status": "ok",
   "result": {
    "command": "MERGE",
    "rows": 2,
    "columns": [
     {"name":"action","type":"text"},
     {"name":"sku","type":"text"},
     {"name":"old_price","type":"numeric"},
     {"name":"new_price","type":"numeric"},
     {"name":"discontinued","type":"bool"}
    ],
    "data": [["UPDATE","BOO-0028","16.90","17.50","f"],["UPDATE","BOO-0054","73.76","69.00","f"]]
