    "813d2c59791224e5": {
      "db": "shop",
      "sql": "CREATE TABLE vip (\n  customer_id int PRIMARY KEY REFERENCES customers,\n  spent       numeric(12,2) NOT NULL\n);\n\nINSERT INTO vip (customer_id, spent)\nSELECT o.customer_id, sum(oi.qty * oi.unit_price)\nFROM orders AS o\nJOIN order_items AS oi ON oi.order_id = o.id\nWHERE o.status <> 'cancelled'\nGROUP BY o.customer_id\nORDER BY sum(oi.qty * oi.unit_price) DESC, o.customer_id\nLIMIT 10;",
      "statements": [
