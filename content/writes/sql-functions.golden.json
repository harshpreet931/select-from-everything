    "9e9974ec4ec718c4": {
      "db": "shop",
      "sql": "CREATE FUNCTION top_customers(n int)\nRETURNS TABLE (customer_id int, orders bigint)\nLANGUAGE sql STABLE\nBEGIN ATOMIC\n  SELECT customer_id, count(*) FROM orders\n  GROUP BY customer_id\n  ORDER BY count(*) DESC, customer_id\n  LIMIT n;\nEND;\n\nSELECT * FROM top_customers(n => 3) ORDER BY orders DESC, customer_id;",
      "statements": [
