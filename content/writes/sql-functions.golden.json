      "sql": "CREATE FUNCTION is_cheap(p numeric) RETURNS boolean LANGUAGE sql RETURN p < 5;\nCREATE FUNCTION is_cheap_sd(p numeric) RETURNS boolean LANGUAGE sql SECURITY DEFINER RETURN p < 5;\n\nEXPLAIN (VERBOSE, COSTS OFF) SELECT count(*) FROM order_items WHERE is_cheap(unit_price);\nEXPLAIN (VERBOSE, COSTS OFF) SELECT count(*) FROM order_items WHERE is_cheap_sd(unit_price);",
