    "b6ef9fb0c5cab868": {
      "db": "shop",
      "sql": "CREATE FUNCTION order_summary(cust int)\nRETURNS TABLE (status text, n bigint)\nLANGUAGE plpgsql STABLE\nAS $$\nBEGIN\n  IF NOT EXISTS (SELECT FROM customers WHERE id = cust) THEN\n    RAISE EXCEPTION 'no customer %', cust\n      USING ERRCODE = 'no_data_found', HINT = 'ids go from 1 to 2000';\n  END IF;\n  RETURN QUERY\n    SELECT o.status, count(*) FROM orders AS o\n    WHERE o.customer_id = cust GROUP BY o.status;\nEND $$;\n\nSELECT * FROM order_summary(42) ORDER BY status;",
