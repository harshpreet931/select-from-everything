      "sql": "CREATE TABLE t (id int PRIMARY KEY, k int NOT NULL, k_sorted int NOT NULL, pad text NOT NULL);\nINSERT INTO t\nSELECT i, (i * 7919) % 30000, i - 1, repeat('x', 100)\nFROM generate_series(1, 30000) AS i\nORDER BY i;\nCREATE INDEX t_k ON t (k);\nCREATE INDEX t_k_sorted ON t (k_sorted);\nVACUUM ANALYZE t;\nSELECT pg_relation_size('t') / 8192 AS pages, pg_relation_size('t_k') / 8192 AS index_pages;",
