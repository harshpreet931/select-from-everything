      "db": "empty",
      "sql": "SELECT am.amname AS method, opf.opfname AS family,\n       string_agg(DISTINCT op.oprname, ' ' ORDER BY op.oprname) AS operators\nFROM pg_amop AS ao\nJOIN pg_am AS am ON am.oid = ao.amopmethod\nJOIN pg_opfamily AS opf ON opf.oid = ao.amopfamily\nJOIN pg_operator AS op ON op.oid = ao.amopopr\nWHERE opf.opfname IN ('integer_ops', 'text_ops', 'text_pattern_ops', 'array_ops',\n                      'jsonb_ops', 'jsonb_path_ops', 'range_ops', 'tsvector_ops', 'integer_minmax_ops')\nGROUP BY am.amname, opf.opfname\nORDER BY am.amname, opf.opfname;",
