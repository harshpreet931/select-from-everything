   "sql": "SELECT lexeme, count(*) AS products, array_agg(id ORDER BY id) AS ids\nFROM products, unnest(to_tsvector('english', name)) AS u\nWHERE lexeme IN ('steel', 'teapot', 'whisk', 'pan', 'knife', 'speaker')\nGROUP BY lexeme\nORDER BY lexeme",
