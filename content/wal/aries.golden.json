      "sql": "BEGIN;\nUPDATE accounts SET balance = 0 WHERE id = 3;\nROLLBACK;\nSELECT lp, t_xmin, t_xmax, pg_xact_status(t_xmax::text::xid8) AS xmax_status\nFROM heap_page_items(get_raw_page('accounts', 0))\nWHERE t_xmax <> 0 ORDER BY lp;\nSELECT lp, t_xmin, pg_xact_status(t_xmin::text::xid8) AS xmin_status\nFROM heap_page_items(get_raw_page('accounts', 0))\nWHERE lp > 3 ORDER BY lp;",
