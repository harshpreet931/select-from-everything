      "db": "lab",
      "sql": "CREATE FUNCTION wal_since(start pg_lsn)\nRETURNS TABLE (lsn pg_lsn, rmgr text, record_type text, len int4, fpi int4, rel name)\nLANGUAGE sql AS $$\n  SELECT r.start_lsn, r.resource_manager, r.record_type, r.record_length, r.fpi_length, c.relname\n  FROM pg_get_wal_records_info(start, pg_current_wal_insert_lsn()) AS r\n  LEFT JOIN pg_get_wal_block_info(start, pg_current_wal_insert_lsn()) AS b ON b.start_lsn = r.start_lsn\n  LEFT JOIN pg_class AS c ON c.relfilenode = b.relfilenode\n$$;\nSELECT set_config('my.start', pg_current_wal_insert_lsn()::text, false) IS NOT NULL AS marked,\n       set_config('my.lsn', pg_current_wal_insert_lsn()::text, false) IS NOT NULL AS also;\nINSERT INTO accounts VALUES (4, 'dave', 10.00);\nSELECT * FROM wal_since(current_setting('my.lsn')::pg_lsn) ORDER BY lsn;",
