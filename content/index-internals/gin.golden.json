      "db": "empty",
      "sql": "CREATE TABLE posts (id int, tags text[]);\nINSERT INTO posts\nSELECT g, ARRAY['sql'] || CASE WHEN g % 10 = 0 THEN ARRAY['postgres'] ELSE ARRAY[]::text[] END\n          || CASE WHEN g % 1000 = 0 THEN ARRAY['gin'] ELSE ARRAY[]::text[] END\nFROM generate_series(1, 20000) AS g;\nCREATE INDEX posts_tags ON posts USING gin (tags);\nSELECT * FROM gin_metapage_info(get_raw_page('posts_tags', 0));\nSELECT b AS blkno, o.flags, o.rightlink, o.maxoff\nFROM generate_series(1, pg_relation_size('posts_tags') / 8192 - 1) AS b,\n     gin_page_opaque_info(get_raw_page('posts_tags', b)) AS o\nORDER BY b;",
