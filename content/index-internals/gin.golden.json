    "f95972f73ae4cb97": {
      "db": "empty",
      "sql": "CREATE TABLE fu (id int, tags text[]);\nCREATE INDEX fu_on ON fu USING gin (tags);\nCREATE TABLE fo (id int, tags text[]);\nCREATE INDEX fo_off ON fo USING gin (tags) WITH (fastupdate = off);\nSELECT 1 AS marked FROM set_config('my.a', pg_current_wal_insert_lsn()::text, false);\nINSERT INTO fu SELECT g, ARRAY['t' || g % 50, 't' || g % 7, 'x'] FROM generate_series(1, 5000) AS g;\nSELECT 1 AS marked FROM set_config('my.b', pg_current_wal_insert_lsn()::text, false);\nINSERT INTO fo SELECT g, ARRAY['t' || g % 50, 't' || g % 7, 'x'] FROM generate_series(1, 5000) AS g;\nSELECT 1 AS marked FROM set_config('my.c', pg_current_wal_insert_lsn()::text, false);\nSELECT n_pending_pages, n_pending_tuples FROM gin_metapage_info(get_raw_page('fu_on', 0));\nSELECT gin_clean_pending_list('fu_on') AS pages_cleaned;\nSELECT 1 AS marked FROM set_config('my.d', pg_current_wal_insert_lsn()::text, false);\nSELECT pg_size_pretty(pg_wal_lsn_diff(current_setting('my.b')::pg_lsn, current_setting('my.a')::pg_lsn)) AS on_inserts,\n       pg_size_pretty(pg_wal_lsn_diff(current_setting('my.d')::pg_lsn, current_setting('my.c')::pg_lsn)) AS on_cleanup,\n       pg_size_pretty(pg_wal_lsn_diff(current_setting('my.c')::pg_lsn, current_setting('my.b')::pg_lsn)) AS off_inserts;\nSELECT pg_relation_size('fu_on') / 8192 AS pages_on, pg_relation_size('fo_off') / 8192 AS pages_off;",
