      "db": "empty",
      "sql": "CREATE TABLE k1 AS SELECT generate_series(1, 1000) AS id;\nCREATE TABLE k100 AS SELECT generate_series(1, 100000) AS id;\nCREATE TABLE k1m AS SELECT generate_series(1, 1000000) AS id;\nCREATE INDEX k1_id ON k1 (id);\nCREATE INDEX k100_id ON k100 (id);\nCREATE INDEX k1m_id ON k1m (id);\nSELECT i AS index, m.level + 1 AS levels,\n       pg_relation_size(i) / 8192 AS pages\nFROM unnest(ARRAY['k1_id', 'k100_id', 'k1m_id']) AS i,\n     bt_metap(i) AS m\nORDER BY pages;",
