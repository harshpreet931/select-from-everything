      "db": "empty",
      "sql": "CREATE TABLE t AS SELECT g AS id FROM generate_series(1, 100000) AS g;\nCREATE INDEX ff100 ON t (id) WITH (fillfactor = 100);\nCREATE INDEX ff90 ON t (id);\nCREATE INDEX ff50 ON t (id) WITH (fillfactor = 50);\nCREATE TABLE app (id int);\nCREATE INDEX app_ff100 ON app (id) WITH (fillfactor = 100);\nINSERT INTO app SELECT generate_series(1, 100000);\nSELECT i AS index, pg_relation_size(i) / 8192 AS pages,\n       round(avg(s.live_items) FILTER (WHERE s.type = 'l')) AS avg_items\nFROM unnest(ARRAY['ff100', 'ff90', 'ff50', 'app_ff100']) AS i,\n     bt_multi_page_stats(i, 1, -1) AS s\nGROUP BY i\nORDER BY pages, i;",
