    "b11086186dcbf34e": {
      "db": "empty",
      "sql": "CREATE TABLE seq (id int);\nCREATE INDEX seq_id ON seq (id);\nINSERT INTO seq SELECT g FROM generate_series(1, 100000) AS g;\nCREATE TABLE rnd (id int);\nCREATE INDEX rnd_id ON rnd (id);\nINSERT INTO rnd SELECT g FROM generate_series(1, 100000) AS g ORDER BY hashint4(g);\nCREATE TABLE built (id int);\nINSERT INTO built SELECT g FROM generate_series(1, 100000) AS g ORDER BY hashint4(g);\nCREATE INDEX built_id ON built (id);\nSELECT i AS index,\n       count(*) FILTER (WHERE s.type = 'l') AS leaves,\n       round(avg(s.live_items) FILTER (WHERE s.type = 'l')) AS avg_items,\n       round(100 - 100.0 * avg(s.free_size) FILTER (WHERE s.type = 'l') / 8160) AS pct_full,\n       pg_size_pretty(pg_relation_size(i)) AS size\nFROM unnest(ARRAY['seq_id', 'rnd_id', 'built_id']) AS i,\n     bt_multi_page_stats(i, 1, -1) AS s\nGROUP BY i\nORDER BY leaves;",
