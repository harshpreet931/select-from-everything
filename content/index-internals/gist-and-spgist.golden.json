      "db": "empty",
      "sql": "CREATE TABLE pts AS\nSELECT g AS id, point(abs(hashint4(g)) % 100, abs(hashint4(-g)) % 100) AS p\nFROM generate_series(1, 1000) AS g;\nCREATE INDEX pts_gist ON pts USING gist (p);\nSELECT b AS blkno, o.flags, o.rightlink,\n       (SELECT count(*) FROM gist_page_items(get_raw_page('pts_gist', b), 'pts_gist')) AS items\nFROM generate_series(0, pg_relation_size('pts_gist') / 8192 - 1) AS b,\n     gist_page_opaque_info(get_raw_page('pts_gist', b)) AS o\nORDER BY b;",
