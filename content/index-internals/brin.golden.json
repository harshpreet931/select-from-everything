    "b7e2dc03aaf830b6": {
      "db": "empty",
      "sql": "SET TimeZone = 'UTC';\nCREATE TABLE readings (id int, at timestamptz, temp int);\nINSERT INTO readings\nSELECT g, timestamptz '2026-01-01 00:00+00' + g * interval '1 minute', abs(hashint4(g)) % 40\nFROM generate_series(1, 200000) AS g;\nCREATE INDEX readings_brin ON readings USING brin (at);\nCREATE INDEX readings_btree ON readings (at);\nANALYZE readings;\nSELECT pg_relation_size('readings') / 8192 AS table_pages,\n       pg_relation_size('readings_brin') / 8192 AS brin_pages,\n       pg_relation_size('readings_btree') / 8192 AS btree_pages;",
