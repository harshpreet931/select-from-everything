    "b25a5597fcd811e4": {
      "db": "empty",
      "sql": "CREATE TABLE shuffled AS SELECT * FROM readings ORDER BY hashint4(id);\nCREATE INDEX shuffled_brin ON shuffled USING brin (at);\nALTER TABLE shuffled ALTER COLUMN at SET STATISTICS 10000;\nALTER TABLE readings ALTER COLUMN at SET STATISTICS 10000;\nANALYZE shuffled, readings;\nSELECT tablename, round(correlation::numeric, 2) AS correlation\nFROM pg_stats WHERE attname = 'at' AND tablename IN ('readings', 'shuffled')\nORDER BY tablename;\nSELECT itemoffset, blknum, value\nFROM brin_page_items(get_raw_page('shuffled_brin', 2), 'shuffled_brin')\nORDER BY blknum;\nEXPLAIN (ANALYZE, BUFFERS, COSTS OFF, TIMING OFF, SUMMARY OFF)\nSELECT count(*) FROM shuffled WHERE at >= '2026-03-01' AND at < '2026-03-02';\nSET enable_seqscan = off;\nEXPLAIN (ANALYZE, BUFFERS, COSTS OFF, TIMING OFF, SUMMARY OFF)\nSELECT count(*) FROM shuffled WHERE at >= '2026-03-01' AND at < '2026-03-02';\nRESET enable_seqscan;",
