    "802fbbc67411c9f2": {
      "db": "empty",
      "sql": "CREATE TABLE truth AS\nSELECT qid, (SELECT array_agg(id ORDER BY d, id)\n             FROM (SELECT id, i.v <-> q.v AS d FROM items AS i ORDER BY d, id LIMIT 10) AS nn) AS ids\nFROM queries AS q;\n-- recall@10 over the 50 queries, with one setting changed for the duration\nCREATE FUNCTION recall(setting text DEFAULT NULL, val int DEFAULT NULL)\nRETURNS numeric LANGUAGE plpgsql AS $$\nDECLARE r record; hits int := 0; got int[];\nBEGIN\n  IF setting IS NOT NULL THEN PERFORM set_config(setting, val::text, true); END IF;\n  FOR r IN SELECT t.ids, q.v FROM truth AS t JOIN queries AS q USING (qid) LOOP\n    SELECT array_agg(id) INTO got FROM (SELECT id FROM items ORDER BY v <-> r.v LIMIT 10) AS s;\n    hits := hits + (SELECT count(*) FROM unnest(r.ids) AS x WHERE x = ANY (got));\n  END LOOP;\n  RETURN round(hits / 500.0, 3);\nEND $$;\nSELECT recall() AS exact_recall;",
