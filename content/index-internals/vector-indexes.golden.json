    "e6d36fe76ff3d2b6": {
      "db": "empty",
      "sql": "CREATE EXTENSION vector;\nSELECT extversion FROM pg_extension WHERE extname = 'vector';\nCREATE TABLE items AS\nSELECT g AS id,\n       (SELECT array_agg((hashint4(g * 64 + d) % 1000) / 1000.0 ORDER BY d)\n        FROM generate_series(1, 32) AS d)::vector(32) AS v\nFROM generate_series(1, 10000) AS g;\nCREATE TABLE queries AS\nSELECT q AS qid,\n       (SELECT array_agg((hashint4(-q * 64 - d) % 1000) / 1000.0 ORDER BY d)\n        FROM generate_series(1, 32) AS d)::vector(32) AS v\nFROM generate_series(1, 50) AS q;\nANALYZE items;\nEXPLAIN (ANALYZE, BUFFERS, COSTS OFF, TIMING OFF, SUMMARY OFF)\nSELECT id FROM items ORDER BY v <-> (SELECT v FROM queries WHERE qid = 1) LIMIT 10;",
