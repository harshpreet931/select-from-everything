      "sql": "CREATE TABLE c (id int);\nCREATE INDEX c_id ON c (id);\nBEGIN;\nINSERT INTO c VALUES (55);\nSELECT locktype, relation::regclass AS rel, mode\nFROM pg_locks\nWHERE pid = pg_backend_pid() AND relation IS DISTINCT FROM 'pg_locks'::regclass\nORDER BY locktype, rel;\nSET LOCAL enable_seqscan = off;\nSELECT count(*) FROM c WHERE id = 55;\nSELECT locktype, relation::regclass AS rel, mode\nFROM pg_locks\nWHERE pid = pg_backend_pid() AND relation IS DISTINCT FROM 'pg_locks'::regclass\nORDER BY locktype, rel;\nCOMMIT;",
