      "sql": "CREATE TABLE accounts (id int PRIMARY KEY, balance numeric(12,2) NOT NULL);\nINSERT INTO accounts VALUES (1, 100.00);\nBEGIN;\nUPDATE accounts SET balance = balance - 10 WHERE id = 1;\nSELECT locktype, relation::regclass, transactionid, virtualxid, mode, granted, fastpath\nFROM pg_locks\nWHERE pid = pg_backend_pid() AND relation IS DISTINCT FROM 'pg_locks'::regclass\nORDER BY locktype, relation::regclass::text;\nCOMMIT;",
