      "db": "empty",
      "sql": "CREATE TABLE t (id int PRIMARY KEY, note text NOT NULL);\nINSERT INTO t VALUES (1, 'key share'), (2, 'share'), (3, 'no key update'), (4, 'update');\nBEGIN;\nSELECT id FROM t WHERE id = 1 FOR KEY SHARE;\nSELECT id FROM t WHERE id = 2 FOR SHARE;\nSELECT id FROM t WHERE id = 3 FOR NO KEY UPDATE;\nSELECT id FROM t WHERE id = 4 FOR UPDATE;\nSELECT lp, t_xmax, t_infomask, t_infomask2,\n       (heap_tuple_infomask_flags(t_infomask, t_infomask2)).combined_flags AS combined,\n       (heap_tuple_infomask_flags(t_infomask, t_infomask2)).raw_flags AS raw\nFROM heap_page_items(get_raw_page('t', 0))\nORDER BY lp;\nROLLBACK;",
