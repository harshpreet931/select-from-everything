      "sql": "CREATE TABLE accounts (id int PRIMARY KEY, balance numeric(12,2) NOT NULL, version int NOT NULL);\nINSERT INTO accounts VALUES (1, 100.00, 1);\nSELECT balance, version FROM accounts WHERE id = 1;     -- the app reads version 1\nUPDATE accounts SET balance = 130.00, version = version + 1\nWHERE id = 1 AND version = 1;                           -- someone else saves first\nUPDATE accounts SET balance = 110.00, version = version + 1\nWHERE id = 1 AND version = 1;                           -- our save: validation fails\nSELECT balance, version FROM accounts WHERE id = 1;",
