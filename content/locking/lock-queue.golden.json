    "e9853c551414369f": {
      "db": "empty",
      "sql": "CREATE TABLE accounts (id int PRIMARY KEY, balance numeric(12,2) NOT NULL);\nDO $$\nBEGIN\n  FOR attempt IN 1..5 LOOP\n    BEGIN\n      SET LOCAL lock_timeout = '500ms';\n      ALTER TABLE accounts ADD COLUMN note text;\n      RETURN;                                   -- got the lock, done\n    EXCEPTION WHEN lock_not_available THEN\n      PERFORM pg_sleep(attempt);                -- back off, then try again\n    END;\n  END LOOP;\n  RAISE EXCEPTION 'could not get the lock after 5 tries';\nEND $$;\nSELECT column_name FROM information_schema.columns\nWHERE table_name = 'accounts' ORDER BY ordinal_position;",
