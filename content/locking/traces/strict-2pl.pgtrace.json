 },
 "base": {"xid":759,"lsn":23210088},
 "setup": "CREATE TABLE accounts (\n  id      int PRIMARY KEY,\n  owner   text NOT NULL,\n  balance numeric(12,2) NOT NULL\n);\nINSERT INTO accounts VALUES (1, 'alice', 100.00), (2, 'bob', 100.00);\nVACUUM accounts;",
 "steps": [
  {
   "i": 0,
   "session": "T1",
   "sql": "BEGIN;\nSELECT balance FROM accounts WHERE id = 1",
   "note": "T1 opens a transaction and reads alice. the only locks are on the table and its index (ACCESS SHARE) and T1's own virtual xid. nothing on the row.",
   "status": "ok",
   "result": {"command":"SELECT","rows":1,"columns":[{"name":"balance","type":"numeric"}],"data":[["100.00"]]},
   "locks": [
    {"session":"T1","type":"relation","target":"accounts","mode":"AccessShareLock","granted":true},
    {"session":"T1","type":"relation","target":"accounts_pkey","mode":"AccessShareLock","granted":true},
    {"session":"T1","type":"virtualxid","target":"4/4","mode":"ExclusiveLock","granted":true}
   ]
  },
  {
   "i": 1,
   "session": "T2",
   "sql": "UPDATE accounts SET balance = balance + 5 WHERE id = 1",
   "note": "T2 updates alice right away. no wait: T1's read left nothing on the row to wait for.",
   "status": "ok",
   "result": {"command":"UPDATE","rows":1,"columns":[],"data":[]},
   "locks": [
    {"session":"T1","type":"relation","target":"accounts","mode":"AccessShareLock","granted":true},
    {"session":"T1","type":"relation","target":"accounts_pkey","mode":"AccessShareLock","granted":true},
    {"session":"T1","type":"virtualxid","target":"4/4","mode":"ExclusiveLock","granted":true}
   ]
  },
  {
   "i": 2,
   "session": "T1",
   "sql": "UPDATE accounts SET balance = balance - 10 WHERE id = 2",
   "note": "T1 updates bob. now it holds ROW EXCLUSIVE on the table and an exclusive lock on its new transaction id, which is what anyone wanting bob's row will wait for.",
   "status": "ok",
   "result": {"command":"UPDATE","rows":1,"columns":[],"data":[]},
   "locks": [
    {"session":"T1","type":"relation","target":"accounts","mode":"AccessShareLock","granted":true},
    {"session":"T1","type":"relation","target":"accounts","mode":"RowExclusiveLock","granted":true},
    {"session":"T1","type":"relation","target":"accounts_pkey","mode":"AccessShareLock","granted":true},
    {"session":"T1","type":"relation","target":"accounts_pkey","mode":"RowExclusiveLock","granted":true},
    {"session":"T1","type":"transactionid","target":"760","mode":"ExclusiveLock","granted":true},
    {"session":"T1","type":"virtualxid","target":"4/4","mode":"ExclusiveLock","granted":true}
   ]
  },
  {
   "i": 3,
   "session": "T1",
   "sql": "SELECT owner FROM accounts WHERE id = 2",
   "note": "the statement is over, and T1 holds everything it took. postgres never lets go of a lock in the middle of a transaction.",
   "status": "ok",
   "result": {"command":"SELECT","rows":1,"columns":[{"name":"owner","type":"text"}],"data":[["bob"]]},
   "locks": [
    {"session":"T1","type":"relation","target":"accounts","mode":"AccessShareLock","granted":true},
    {"session":"T1","type":"relation","target":"accounts","mode":"RowExclusiveLock","granted":true},
    {"session":"T1","type":"relation","target":"accounts_pkey","mode":"AccessShareLock","granted":true},
    {"session":"T1","type":"relation","target":"accounts_pkey","mode":"RowExclusiveLock","granted":true},
    {"session":"T1","type":"transactionid","target":"760","mode":"ExclusiveLock","granted":true},
    {"session":"T1","type":"virtualxid","target":"4/4","mode":"ExclusiveLock","granted":true}
   ]
  },
  {
   "i": 4,
   "session": "T2",
   "sql": "UPDATE accounts SET balance = balance + 10 WHERE id = 2",
   "note": "T2 wants bob's row, so it waits for T1's transaction id.",
   "status": "blocked",
   "blocked": {
    "by": ["T1"],
    "lock": {"session":"T2","type":"transactionid","target":"760","mode":"ShareLock","granted":false}
   },
   "locks": [
    {"session":"T1","type":"relation","target":"accounts","mode":"AccessShareLock","granted":true},
    {"session":"T1","type":"relation","target":"accounts","mode":"RowExclusiveLock","granted":true},
    {"session":"T1","type":"relation","target":"accounts_pkey","mode":"AccessShareLock","granted":true},
    {"session":"T1","type":"relation","target":"accounts_pkey","mode":"RowExclusiveLock","granted":true},
    {"session":"T1","type":"transactionid","target":"760","mode":"ExclusiveLock","granted":true},
    {"session":"T1","type":"virtualxid","target":"4/4","mode":"ExclusiveLock","granted":true},
    {"session":"T2","type":"relation","target":"accounts","mode":"RowExclusiveLock","granted":true},
    {"session":"T2","type":"relation","target":"accounts_pkey","mode":"RowExclusiveLock","granted":true},
    {"session":"T2","type":"transactionid","target":"761","mode":"ExclusiveLock","granted":true},
    {"session":"T2","type":"tuple","target":"accounts (0,2)","mode":"ExclusiveLock","granted":true},
    {"session":"T2","type":"virtualxid","target":"5/5","mode":"ExclusiveLock","granted":true},
    {"session":"T2","type":"transactionid","target":"760","mode":"ShareLock","granted":false}
   ]
  },
  {
   "i": 5,
   "session": "T1",
   "sql": "COMMIT",
   "note": "COMMIT releases every lock T1 held, all at once. T2 goes through.",
   "status": "ok",
   "result": {"command":"COMMIT","rows":null,"columns":[],"data":[]},
   "woke": [{"session":"T2","step":4,"result":{"command":"UPDATE","rows":1,"columns":[],"data":[]}}],
