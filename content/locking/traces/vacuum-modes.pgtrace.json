  "accounts_pkey": {"kind":"index","am":"btree","columns":[{"name":"id","type":"int4"}],"on":"accounts"}
 },
 "base": {"xid":759,"lsn":23210088},
 "setup": "CREATE TABLE accounts (\n  id      int PRIMARY KEY,\n  owner   text NOT NULL,\n  balance numeric(12,2) NOT NULL\n);\nINSERT INTO accounts VALUES (1, 'alice', 100.00), (2, 'bob', 100.00);\nVACUUM accounts;",
 "steps": [
  {
   "i": 0,
   "session": "T1",
   "sql": "BEGIN;\nSELECT sum(balance) FROM accounts",
   "note": "T1 reads accounts in an open transaction: ACCESS SHARE.",
   "status": "ok",
   "result": {"command":"SELECT","rows":1,"columns":[{"name":"sum","type":"numeric"}],"data":[["200.00"]]},
   "locks": [
    {"session":"T1","type":"relation","target":"accounts","mode":"AccessShareLock","granted":true},
    {"session":"T1","type":"relation","target":"accounts_pkey","mode":"AccessShareLock","granted":true},
    {"session":"T1","type":"virtualxid","target":"4/4","mode":"ExclusiveLock","granted":true}
   ]
  },
  {
   "i": 1,
   "session": "T2",
   "sql": "VACUUM accounts",
   "note": "plain VACUUM takes SHARE UPDATE EXCLUSIVE. no conflict with a reader: it runs right away.",
   "status": "ok",
   "result": {"command":"VACUUM","rows":null,"columns":[],"data":[]},
   "locks": [
    {"session":"T1","type":"relation","target":"accounts","mode":"AccessShareLock","granted":true},
    {"session":"T1","type":"relation","target":"accounts_pkey","mode":"AccessShareLock","granted":true},
    {"session":"T1","type":"virtualxid","target":"4/4","mode":"ExclusiveLock","granted":true}
   ]
  },
  {
   "i": 2,
   "session": "T2",
   "sql": "VACUUM FULL accounts",
   "note": "VACUUM FULL rewrites the table, so it wants ACCESS EXCLUSIVE, and waits for the reader.",
   "status": "blocked",
   "blocked": {
    "by": ["T1"],
    "lock": {"session":"T2","type":"relation","target":"accounts","mode":"AccessExclusiveLock","granted":false}
   },
   "locks": [
    {"session":"T1","type":"relation","target":"accounts","mode":"AccessShareLock","granted":true},
    {"session":"T1","type":"relation","target":"accounts_pkey","mode":"AccessShareLock","granted":true},
    {"session":"T1","type":"virtualxid","target":"4/4","mode":"ExclusiveLock","granted":true},
    {"session":"T2","type":"transactionid","target":"759","mode":"ExclusiveLock","granted":true},
    {"session":"T2","type":"virtualxid","target":"5/9","mode":"ExclusiveLock","granted":true},
    {"session":"T2","type":"relation","target":"accounts","mode":"AccessExclusiveLock","granted":false}
   ]
  },
  {
   "i": 3,
   "session": "T1",
   "sql": "COMMIT",
   "note": "T1 ends, and VACUUM FULL gets its lock.",
   "status": "ok",
   "result": {"command":"COMMIT","rows":null,"columns":[],"data":[]},
   "woke": [{"session":"T2","step":2,"result":{"command":"VACUUM","rows":null,"columns":[],"data":[]}}],
