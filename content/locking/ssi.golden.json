      "sql": "BEGIN ISOLATION LEVEL SERIALIZABLE;\nSELECT balance FROM accounts WHERE id = 1;\nSELECT owner FROM accounts WHERE id = 2;\nSELECT locktype, relation::regclass, page, tuple\nFROM pg_locks WHERE mode = 'SIReadLock'\nORDER BY locktype, relation::regclass::text, page, tuple;\nSELECT count(*) FROM accounts WHERE balance > 1000;\nSELECT locktype, relation::regclass, page, tuple\nFROM pg_locks WHERE mode = 'SIReadLock'\nORDER BY locktype, relation::regclass::text, page, tuple;\nCOMMIT;",
