     ["  ->  Seq Scan on orders o (actual rows=10000.00 loops=1)"],
     ["        Buffers: shared hit=14 read=69"],
     ["  ->  Materialize (actual rows=64.51 loops=10000)"],
     ["        Storage: Memory  Maximum Storage: 19kB"],
     ["        Buffers: shared hit=1 read=23"],
     ["        ->  Seq Scan on customers c (actual rows=66.00 loops=1)"],
     ["              Filter: (city = 'Paris'::text)"],
