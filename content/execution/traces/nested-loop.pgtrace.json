 "steps": [
  {
   "i": 0,
   "session": "T1",
   "sql": "SELECT id, name FROM customers WHERE id <= 4 ORDER BY id",
   "note": "four customers, the outer side of the small join.",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 4,
    "columns": [{"name":"id","type":"int4"},{"name":"name","type":"text"}],
    "data": [["1","Maya Chen"],["2","Grace Okafor"],["3","Sam Lee"],["4","Zoë Martin"]]
   }
  },
  {
   "i": 1,
   "session": "T1",
   "sql": "SELECT id, customer_id FROM orders\nWHERE id IN (1, 47, 511, 529, 566, 716) OR id = (SELECT min(id) FROM orders WHERE customer_id = 6)\nORDER BY id",
   "note": "six of their orders and one of customer 6, the inner side.",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 7,
    "columns": [{"name":"id","type":"int4"},{"name":"customer_id","type":"int4"}],
    "data": [["1","1"],["47","1"],["511","3"],["529","2"],["566","2"],["716","3"],["1596","6"]]
   }
  },
  {
   "i": 2,
   "session": "T1",
   "sql": "SET enable_hashjoin = off;\nSET enable_mergejoin = off;\nSET enable_memoize = off;\nSET enable_indexscan = off;\nSET enable_bitmapscan = off;\nEXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF)\nSELECT c.name, o.id FROM customers AS c JOIN orders AS o ON o.customer_id = c.id WHERE c.city = 'Paris'",
   "note": "hash and merge joins off, and no index either: every order is compared with the 66 paris customers, kept in memory by a Materialize, until it finds its own.",
   "status": "ok",
   "result": {
    "command": "EXPLAIN",
    "rows": null,
    "columns": [{"name":"QUERY PLAN","type":"text"}],
    "data": [
     ["Nested Loop (actual rows=369.00 loops=1)"],
