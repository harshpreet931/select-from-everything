    "3b7c422f15c52986": {
      "db": "events",
      "sql": "CREATE TABLE ev (user_id int, kind text, occurred_at timestamptz) PARTITION BY RANGE (occurred_at);\nCREATE TABLE ev_mar PARTITION OF ev FOR VALUES FROM ('2026-03-01') TO ('2026-04-01');\nCREATE TABLE ev_apr PARTITION OF ev FOR VALUES FROM ('2026-04-01') TO ('2026-05-01');\nCREATE TABLE ev_may PARTITION OF ev FOR VALUES FROM ('2026-05-01') TO ('2026-06-01');\nINSERT INTO ev SELECT user_id, kind, occurred_at FROM events ORDER BY id;\nANALYZE ev;\n\nSET enable_partitionwise_aggregate = on;\nEXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF)\nSELECT kind, count(*) FROM ev GROUP BY kind ORDER BY kind;",
