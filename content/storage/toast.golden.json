      "db": "lab",
      "sql": "CREATE TABLE docs (id int PRIMARY KEY, title text, body text);\nINSERT INTO docs VALUES (1, 'one', repeat('a', 1000)),\n                        (2, 'two', repeat('a', 3000)),\n                        (3, 'three', repeat('a', 1000000));\nINSERT INTO docs SELECT 4, 'four', string_agg(md5(g::text), '' ORDER BY g)\nFROM generate_series(1, 100) AS g;\nINSERT INTO docs SELECT 5, 'five', string_agg(md5(g::text), '' ORDER BY g)\nFROM generate_series(1, 31250) AS g;\nSELECT d.id, octet_length(d.body) AS bytes, pg_column_size(d.body) AS stored,\n       pg_column_compression(d.body) AS method, h.lp_len AS row_bytes\nFROM docs d JOIN heap_page_items(get_raw_page('docs', 0)) h ON h.t_ctid = d.ctid\nORDER BY d.id;",
