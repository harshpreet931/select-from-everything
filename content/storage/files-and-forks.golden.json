      "sql": "CREATE UNLOGGED TABLE big (pad text);\nALTER TABLE big ALTER COLUMN pad SET STORAGE PLAIN;\nINSERT INTO big SELECT repeat('x', 2000) FROM generate_series(1, 530000);\nSELECT pg_relation_size('big') / 8192 AS pages;\nSELECT replace(f, pg_relation_filenode('big')::text, '<relfilenode>') AS file,\n       (pg_stat_file(regexp_replace(pg_relation_filepath('big'), '[0-9]+$', '') || f)).size AS bytes\nFROM pg_ls_dir(regexp_replace(pg_relation_filepath('big'), '/[0-9]+$', '')) AS f\nWHERE f LIKE pg_relation_filenode('big') || '%'\nORDER BY f;",
