      "sql": "WITH RECURSIVE team AS (\n  SELECT id, name, 1 AS depth FROM employees WHERE manager_id = 2\n  UNION ALL\n  SELECT e.id, e.name, team.depth + 1\n  FROM employees AS e JOIN team ON e.manager_id = team.id\n)\nSELECT depth, count(*) AS people FROM team GROUP BY depth ORDER BY depth;",
