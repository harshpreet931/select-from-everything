    "35019e813d01c243": {
      "db": "org",
      "sql": "CREATE TABLE org_paths AS\nWITH RECURSIVE t AS (\n  SELECT id, name, text2ltree(id::text) AS path FROM employees WHERE manager_id IS NULL\n  UNION ALL\n  SELECT e.id, e.name, t.path || e.id::text FROM employees AS e JOIN t ON e.manager_id = t.id\n) SELECT * FROM t;\nCREATE INDEX ON org_paths USING gist (path);\n\nSELECT count(*) AS team FROM org_paths WHERE path <@ '1.2' AND path <> '1.2';\nSELECT path, name FROM org_paths WHERE path @> (SELECT path FROM org_paths WHERE id = 287) ORDER BY nlevel(path);",
