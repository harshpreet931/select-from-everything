      "db": "empty",
      "sql": "CREATE ROLE rls_writer;\nCREATE TABLE notes (id int PRIMARY KEY, tenant text NOT NULL, body text NOT NULL);\nGRANT SELECT, INSERT ON notes TO rls_writer;\nALTER TABLE notes ENABLE ROW LEVEL SECURITY;\nCREATE POLICY see_own ON notes FOR SELECT USING (tenant = current_setting('app.tenant', true));\nCREATE POLICY write_any ON notes FOR INSERT WITH CHECK (true);\n\nSET app.tenant = 'acme';\nSET ROLE rls_writer;\nINSERT INTO notes VALUES (5, 'globex', 'hello');\nSELECT count(*) AS visible_to_me FROM notes;\nRESET ROLE;\nSELECT count(*) AS really_there FROM notes;",
