    {"session":"T1","type":"transactionid","target":"761","mode":"ExclusiveLock","granted":true},
    {"session":"T1","type":"virtualxid","target":"4/4","mode":"ExclusiveLock","granted":true}
   ]
  },
  {
   "i": 1,
   "session": "obs",
   "sql": "SELECT locked_row, modes FROM pgrowlocks('customers')",
   "note": "pgrowlocks reads the lock off Ada's row: one locker, mode For Key Share.",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 1,
    "columns": [{"name":"locked_row","type":"tid"},{"name":"modes","type":"_text"}],
