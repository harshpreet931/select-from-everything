    {"session":"T1","type":"transactionid","target":"761","mode":"ExclusiveLock","granted":true},
    {"session":"T1","type":"virtualxid","target":"4/4","mode":"ExclusiveLock","granted":true}
   ]
  },
  {
   "i": 2,
   "session": "T2",
   "sql": "UPDATE customers SET city = 'bristol' WHERE id = 42",
   "note": "T2 changes Ada's city. an UPDATE that doesn't touch a key column takes FOR NO KEY UPDATE, which doesn't conflict with KEY SHARE. no wait.",
   "status": "ok",
   "result": {"command":"UPDATE","rows":1,"columns":[],"data":[]},
   "locks": [
