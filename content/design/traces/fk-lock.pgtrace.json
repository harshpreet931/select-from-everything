 "setup": "CREATE TABLE customers (id int PRIMARY KEY, name text NOT NULL, city text);\nCREATE TABLE orders (id int PRIMARY KEY, customer_id int NOT NULL REFERENCES customers, total numeric(8,2) NOT NULL);\nINSERT INTO customers VALUES (42, 'Ada Lovelace', 'london'), (7, 'Ming Li', 'manchester');\nVACUUM customers;",
 "steps": [
  {
   "i": 0,
   "session": "T1",
   "sql": "BEGIN;\nINSERT INTO orders VALUES (1, 42, 22.00)",
   "note": "T1 places an order for customer 42 and doesn't commit yet. the foreign key check locks Ada's row FOR KEY SHARE, so nobody can delete her, or change her id, before T1 is done.",
   "status": "ok",
   "result": {"command":"INSERT","rows":1,"columns":[],"data":[]},
   "locks": [
    {"session":"T1","type":"relation","target":"customers","mode":"RowShareLock","granted":true},
