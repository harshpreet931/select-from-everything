 "steps": [
  {
   "i": 0,
   "session": "T1",
   "sql": "BEGIN;\nUPDATE posts SET comment_count = comment_count + 1 WHERE id = 1",
   "note": "T1 adds a comment and bumps post 1's counter. its transaction is still open, so it holds the row lock.",
   "status": "ok",
   "result": {"command":"UPDATE","rows":1,"columns":[],"data":[]},
