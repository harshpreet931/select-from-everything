    {"session":"T1","type":"virtualxid","target":"4/4","mode":"ExclusiveLock","granted":true},
    {"session":"T2","type":"relation","target":"posts","mode":"RowExclusiveLock","granted":true},
    {"session":"T2","type":"relation","target":"posts_pkey","mode":"RowExclusiveLock","granted":true},
    {"session":"T2","type":"transactionid","target":"760","mode":"ExclusiveLock","granted":true},
    {"session":"T2","type":"tuple","target":"posts (0,1)","mode":"ExclusiveLock","granted":true},
    {"session":"T2","type":"virtualxid","target":"5/4","mode":"ExclusiveLock","granted":true},
    {"session":"T2","type":"transactionid","target":"759","mode":"ShareLock","granted":false}
   ]
  },
  {
