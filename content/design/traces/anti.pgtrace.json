 "setup": "",
 "steps": [
  {
   "i": 0,
   "session": "T1",
   "sql": "CREATE TABLE product_attrs (product_id int, attr text, value text, PRIMARY KEY (product_id, attr));\nINSERT INTO product_attrs VALUES\n  (1, 'name', 'assam tea'), (1, 'price', '6.50'), (1, 'color', 'red'),\n  (2, 'name', 'blue mug'),  (2, 'price', '12.00'), (2, 'color', 'blue'),\n  (3, 'name', 'teapot'),    (3, 'price', '45.00'), (3, 'color', 'red'),\n  (4, 'name', 'tea towel'), (4, 'price', '9.00'), (4, 'colour', 'red')",
   "note": "EAV: every attribute is a row, every value is text.",
   "status": "ok",
   "result": {"command":"INSERT","rows":12,"columns":[],"data":[]}
  },
  {
   "i": 1,
   "session": "T1",
   "sql": "SELECT n.value AS name, p.value AS price\nFROM product_attrs AS n\nJOIN product_attrs AS p ON p.product_id = n.product_id AND p.attr = 'price'\nJOIN product_attrs AS c ON c.product_id = n.product_id AND c.attr = 'color'\nWHERE n.attr = 'name' AND c.value = 'red' AND p.value < '9.50'\nORDER BY n.product_id",
   "note": "red products under 9.50: a self-join per attribute, and a text comparison. as strings '45.00' < '9.50', so the teapot sneaks in, and the tea towel is lost to a misspelled attribute name.",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 2,
    "columns": [{"name":"name","type":"text"},{"name":"price","type":"text"}],
    "data": [["assam tea","6.50"],["teapot","45.00"]]
   }
  },
  {
   "i": 2,
   "session": "T1",
   "sql": "CREATE TABLE products (id int PRIMARY KEY, name text NOT NULL, price numeric(8,2) NOT NULL CHECK (price >= 0), color text);\nINSERT INTO products VALUES (1, 'assam tea', 6.50, 'red'), (2, 'blue mug', 12.00, 'blue'), (3, 'teapot', 45.00, 'red'), (4, 'tea towel', 9.00, 'red')",
   "note": "the fix: real columns with real types.",
   "status": "ok",
   "result": {"command":"INSERT","rows":4,"columns":[],"data":[]}
  },
  {
   "i": 3,
   "session": "T1",
   "sql": "SELECT name, price FROM products WHERE color = 'red' AND price < 9.50 ORDER BY id",
   "note": "one table, numeric comparison, no joins.",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 2,
    "columns": [{"name":"name","type":"text"},{"name":"price","type":"numeric"}],
    "data": [["assam tea","6.50"],["tea towel","9.00"]]
   }
  },
  {
   "i": 4,
   "session": "T1",
   "sql": "CREATE TABLE posts (id int PRIMARY KEY, title text NOT NULL);\nCREATE TABLE photos (id int PRIMARY KEY, caption text NOT NULL);\nCREATE TABLE comments (id int PRIMARY KEY, target_type text NOT NULL, target_id int NOT NULL, body text NOT NULL);\nINSERT INTO posts VALUES (1, 'why pages are 8 KB');\nINSERT INTO photos VALUES (1, 'the left-handed teapot')",
   "note": "polymorphic association: a comment points at a post or a photo, named by a type column and an id.",
   "status": "ok",
   "result": {"command":"INSERT","rows":1,"columns":[],"data":[]}
  },
  {
   "i": 5,
   "session": "T1",
   "sql": "INSERT INTO comments VALUES (1, 'post', 1, 'nice'), (2, 'photo', 1, 'lovely'), (3, 'post', 99, 'orphan from day one');\nSELECT c.id, c.target_type, c.target_id, coalesce(p.title, ph.caption) AS target\nFROM comments AS c\nLEFT JOIN posts AS p ON c.target_type = 'post' AND p.id = c.target_id\nLEFT JOIN photos AS ph ON c.target_type = 'photo' AND ph.id = c.target_id\nORDER BY c.id",
   "note": "no foreign key is possible on (target_type, target_id), so a comment on post 99, which doesn't exist, goes straight in.",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 3,
    "columns": [
     {"name":"id","type":"int4"},
     {"name":"target_type","type":"text"},
     {"name":"target_id","type":"int4"},
     {"name":"target","type":"text"}
    ],
    "data": [["1","post","1","why pages are 8 KB"],["2","photo","1","the left-handed teapot"],["3","post","99",null]]
   }
  },
  {
   "i": 6,
   "session": "T1",
   "sql": "CREATE TABLE comments2 (\n  id       int PRIMARY KEY,\n  post_id  int REFERENCES posts,\n  photo_id int REFERENCES photos,\n  body     text NOT NULL,\n  CHECK (num_nonnulls(post_id, photo_id) = 1)\n);\nINSERT INTO comments2 VALUES (1, 1, NULL, 'nice'), (2, NULL, 1, 'lovely')",
   "note": "the fix: one nullable foreign key per target, and a CHECK that exactly one is set.",
   "status": "ok",
   "result": {"command":"INSERT","rows":2,"columns":[],"data":[]}
  },
  {
   "i": 7,
   "session": "T1",
   "sql": "INSERT INTO comments2 VALUES (3, 99, NULL, 'orphan from day one')",
   "note": "the same orphan, refused.",
   "status": "error",
   "error": {
    "sqlstate": "23503",
    "message": "insert or update on table \"comments2\" violates foreign key constraint \"comments2_post_id_fkey\"",
    "detail": "Key (post_id)=(99) is not present in table \"posts\"."
   }
  },
  {
   "i": 8,
   "session": "T1",
   "sql": "CREATE TABLE articles (id int PRIMARY KEY, title text NOT NULL, tags text NOT NULL);\nINSERT INTO articles VALUES (1, 'roses', 'red,garden'), (2, 'thermal cameras', 'infrared,tech'), (3, 'apples', 'fruit,red')",
   "note": "comma list: tags in a text column.",
   "status": "ok",
   "result": {"command":"INSERT","rows":3,"columns":[],"data":[]}
  },
  {
   "i": 9,
   "session": "T1",
   "sql": "SELECT id, title, tags FROM articles WHERE tags LIKE '%red%' ORDER BY id",
   "note": "articles tagged red, with LIKE. infrared matches too.",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 3,
    "columns": [{"name":"id","type":"int4"},{"name":"title","type":"text"},{"name":"tags","type":"text"}],
    "data": [["1","roses","red,garden"],["2","thermal cameras","infrared,tech"],["3","apples","fruit,red"]]
   }
  },
  {
   "i": 10,
   "session": "T1",
   "sql": "CREATE TABLE article_tags (article_id int REFERENCES articles, tag text, PRIMARY KEY (article_id, tag));\nINSERT INTO article_tags SELECT id, t FROM articles, string_to_table(tags, ',') AS t ORDER BY 1, 2",
   "note": "the fix: a junction table, one row per tag.",
   "status": "ok",
   "result": {"command":"INSERT","rows":6,"columns":[],"data":[]}
  },
  {
   "i": 11,
   "session": "T1",
   "sql": "SELECT a.id, a.title FROM articles AS a JOIN article_tags AS t ON t.article_id = a.id WHERE t.tag = 'red' ORDER BY a.id",
   "note": "an exact match, indexable, and a tag count is a GROUP BY.",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 2,
    "columns": [{"name":"id","type":"int4"},{"name":"title","type":"text"}],
    "data": [["1","roses"],["3","apples"]]
   }
  },
  {
   "i": 12,
   "session": "T1",
   "sql": "CREATE TABLE customers (id int PRIMARY KEY, name text NOT NULL);\nCREATE TABLE orders (id int PRIMARY KEY, customer_id int NOT NULL, total numeric(8,2) NOT NULL);\nINSERT INTO customers VALUES (1, 'Ada'), (2, 'Grace');\nINSERT INTO orders VALUES (10, 1, 22.00), (11, 2, 6.50), (12, 3, 15.00);\nDELETE FROM customers WHERE id = 2",
   "note": "missing foreign keys: orders.customer_id is just an int.",
   "status": "ok",
   "result": {"command":"DELETE","rows":1,"columns":[],"data":[]}
  },
  {
   "i": 13,
   "session": "T1",
   "sql": "SELECT c.name, sum(o.total) AS revenue FROM orders AS o JOIN customers AS c ON c.id = o.customer_id GROUP BY c.name ORDER BY c.name",
   "note": "an inner join quietly drops the orders whose customer doesn't exist. revenue by customer is short by two orders.",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 1,
    "columns": [{"name":"name","type":"text"},{"name":"revenue","type":"numeric"}],
    "data": [["Ada","22.00"]]
   }
  },
  {
   "i": 14,
   "session": "T1",
   "sql": "SELECT o.id, o.customer_id FROM orders AS o WHERE NOT EXISTS (SELECT 1 FROM customers AS c WHERE c.id = o.customer_id) ORDER BY o.id",
   "note": "the fix starts by finding the orphans.",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 2,
    "columns": [{"name":"id","type":"int4"},{"name":"customer_id","type":"int4"}],
    "data": [["11","2"],["12","3"]]
   }
  },
  {
   "i": 15,
   "session": "T1",
   "sql": "ALTER TABLE orders ADD CONSTRAINT orders_customer_id_fkey FOREIGN KEY (customer_id) REFERENCES customers",
   "note": "then the foreign key. adding it checks every existing row and refuses while orphans exist. NOT VALID would protect new rows now and leave the old ones for later.",
   "status": "error",
   "error": {
    "sqlstate": "23503",
    "message": "insert or update on table \"orders\" violates foreign key constraint \"orders_customer_id_fkey\"",
    "detail": "Key (customer_id)=(2) is not present in table \"customers\"."
   }
