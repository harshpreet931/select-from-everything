  {
   "i": 0,
   "session": "T1",
   "sql": "SELECT pg_stat_statements_reset() IS NOT NULL AS reset",
   "note": "start counting from zero.",
   "status": "ok",
   "result": {"command":"SELECT","rows":1,"columns":[{"name":"reset","type":"bool"}],"data":[["t"]]}
