  {
   "i": 1,
   "session": "T1",
   "sql": "DO $$\nDECLARE\n  r record;\n  n bigint;\nBEGIN\n  FOR r IN SELECT id FROM orders ORDER BY ordered_at DESC, id LIMIT 100 LOOP\n    SELECT sum(qty) INTO n FROM order_items WHERE order_id = r.id;\n  END LOOP;\nEND $$",
   "note": "the N+1 version: one query for the 100 latest orders, then one query per order for its items.",
   "status": "ok",
   "result": {"command":"DO","rows":null,"columns":[],"data":[]}
