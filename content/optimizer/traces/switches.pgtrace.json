 "steps": [
  {
   "i": 0,
   "session": "T1",
   "sql": "RESET ALL;\nEXPLAIN\nSELECT c.name, o.ordered_at\nFROM customers AS c\nJOIN orders AS o ON o.customer_id = c.id\nWHERE c.city = 'Paris'",
   "note": "nothing turned off: a hash join, the cheapest plan.",
   "status": "ok",
   "result": {
    "command": "EXPLAIN",
    "rows": null,
    "columns": [{"name":"QUERY PLAN","type":"text"}],
    "data": [
     ["Hash Join  (cost=49.83..259.13 rows=330 width=20)"],
     ["  Hash Cond: (o.customer_id = c.id)"],
     ["  ->  Seq Scan on orders o  (cost=0.00..183.00 rows=10000 width=12)"],
     ["  ->  Hash  (cost=49.00..49.00 rows=66 width=16)"],
     ["        ->  Seq Scan on customers c  (cost=0.00..49.00 rows=66 width=16)"],
     ["              Filter: (city = 'Paris'::text)"]
    ]
   }
  },
  {
   "i": 1,
   "session": "T1",
   "sql": "RESET ALL;\nSET enable_hashjoin = off;\nEXPLAIN\nSELECT c.name, o.ordered_at\nFROM customers AS c\nJOIN orders AS o ON o.customer_id = c.id\nWHERE c.city = 'Paris'",
   "note": "hash joins off: the next cheapest is a merge join, sorting both sides first.",
   "status": "ok",
   "result": {
    "command": "EXPLAIN",
    "rows": null,
    "columns": [{"name":"QUERY PLAN","type":"text"}],
    "data": [
     ["Merge Join  (cost=898.39..952.01 rows=330 width=20)"],
     ["  Merge Cond: (c.id = o.customer_id)"],
     ["  ->  Sort  (cost=50.99..51.16 rows=66 width=16)"],
     ["        Sort Key: c.id"],
     ["        ->  Seq Scan on customers c  (cost=0.00..49.00 rows=66 width=16)"],
     ["              Filter: (city = 'Paris'::text)"],
     ["  ->  Sort  (cost=847.39..872.39 rows=10000 width=12)"],
     ["        Sort Key: o.customer_id"],
     ["        ->  Seq Scan on orders o  (cost=0.00..183.00 rows=10000 width=12)"]
    ]
   }
  },
  {
   "i": 2,
   "session": "T1",
   "sql": "RESET ALL;\nSET enable_hashjoin = off;\nSET enable_mergejoin = off;\nEXPLAIN\nSELECT c.name, o.ordered_at\nFROM customers AS c\nJOIN orders AS o ON o.customer_id = c.id\nWHERE c.city = 'Paris'",
   "note": "merge joins off too: a nested loop, with a Memoize in front of the index on customers.",
   "status": "ok",
   "result": {
    "command": "EXPLAIN",
    "rows": null,
    "columns": [{"name":"QUERY PLAN","type":"text"}],
    "data": [
     ["Nested Loop  (cost=0.29..1041.95 rows=330 width=20)"],
     ["  ->  Seq Scan on orders o  (cost=0.00..183.00 rows=10000 width=12)"],
     ["  ->  Memoize  (cost=0.29..0.32 rows=1 width=16)"],
     ["        Cache Key: o.customer_id"],
     ["        Cache Mode: logical"],
     ["        ->  Index Scan using customers_pkey on customers c  (cost=0.28..0.31 rows=1 width=16)"],
     ["              Index Cond: (id = o.customer_id)"],
     ["              Filter: (city = 'Paris'::text)"]
    ]
   }
  },
  {
   "i": 3,
   "session": "T1",
   "sql": "RESET ALL;\nSET enable_hashjoin = off;\nSET enable_mergejoin = off;\nSET enable_nestloop = off;\nEXPLAIN\nSELECT c.name, o.ordered_at\nFROM customers AS c\nJOIN orders AS o ON o.customer_id = c.id\nWHERE c.city = 'Paris'",
