      "sql": "DROP STATISTICS customers_city_country;\nCREATE STATISTICS customers_city_country (mcv) ON city, country FROM customers;\nANALYZE customers;\nSELECT m.values, m.frequency\nFROM pg_statistic_ext AS s\nJOIN pg_statistic_ext_data AS d ON d.stxoid = s.oid,\n     pg_mcv_list_items(d.stxdmcv) AS m\nWHERE s.stxname = 'customers_city_country'\nORDER BY m.frequency DESC, m.index\nLIMIT 5;\nEXPLAIN (ANALYZE, TIMING OFF, SUMMARY OFF, BUFFERS OFF)\nSELECT * FROM customers WHERE city = 'Paris' AND country = 'US';",
