   "session": "T1",
   "sql": "SELECT year, status, count(*) AS orders, GROUPING(year, status) AS g\nFROM (SELECT extract(year FROM ordered_at)::int AS year, status FROM orders) AS o\nGROUP BY year, status\nORDER BY year NULLS LAST, status NULLS LAST",
   "note": "plain GROUP BY: one row per year and status that exists. 9 rows, and GROUPING() is 0 on every one: nothing is rolled up.",
   "status": "ok",
