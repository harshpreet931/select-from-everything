   "sql": "SELECT category, name, units\nFROM (SELECT *, row_number() OVER (PARTITION BY category ORDER BY units DESC, id) AS n\n      FROM product_sales) AS ranked\nWHERE n = 1\nORDER BY category",
   "note": "row_number: number each category's products, keep number 1. the three products with no category are a partition of their own, so there's a NULL row.",
