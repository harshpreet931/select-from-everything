    "columns": [{"name":"QUERY PLAN","type":"text"}],
    "data": [
     ["Subquery Scan on ranked"],
     ["  Filter: (ranked.n = 1)"],
     ["  ->  WindowAgg"],
     [
      "        Window: w1 AS (PARTITION BY product_sales.category ORDER BY product_sales.units, product_sales.id ROWS UNBOUNDED PRECEDING)"
