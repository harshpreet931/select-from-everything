   "sql": "EXPLAIN (COSTS OFF)\nSELECT category, name, units\nFROM (SELECT *, row_number() OVER (PARTITION BY category ORDER BY units DESC, id) AS n\n      FROM product_sales) AS ranked\nWHERE n = 1\nORDER BY category",
   "note": "one sort by category and units, a WindowAgg that stops numbering each category after 1 (the run condition), and a filter on top.",
   "status": "ok",
   "result": {
    "command": "EXPLAIN",
