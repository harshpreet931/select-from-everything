  {
   "i": 2,
   "session": "T1",
   "sql": "SELECT c.category, s.name, s.units\nFROM (SELECT DISTINCT category FROM product_sales) AS c\nCROSS JOIN LATERAL (\n  SELECT name, units FROM product_sales AS s\n  WHERE s.category = c.category\n  ORDER BY units DESC, id\n  LIMIT 1\n) AS s\nORDER BY c.category",
   "note": "LATERAL: list the categories, then run a top-1 subquery for each. the NULL category is gone: s.category = NULL is never true.",
   "status": "ok",
