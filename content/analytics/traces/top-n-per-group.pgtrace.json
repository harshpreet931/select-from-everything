   "sql": "EXPLAIN (COSTS OFF)\nSELECT c.category, s.name, s.units\nFROM (SELECT DISTINCT category FROM product_sales) AS c\nCROSS JOIN LATERAL (\n  SELECT name, units FROM product_sales AS s\n  WHERE s.category = c.category\n  ORDER BY units DESC, id\n  LIMIT 1\n) AS s\nORDER BY c.category",
