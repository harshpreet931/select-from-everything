 "base": {"xid":800,"lsn":33644808},
 "setup": "CREATE TABLE product_sales AS\nSELECT p.id, p.name, p.category, sum(oi.qty)::int AS units\nFROM products AS p\nJOIN order_items AS oi ON oi.product_id = p.id\nGROUP BY p.id\nORDER BY p.id;\nANALYZE product_sales;",
 "steps": [
  {
   "i": 0,
   "session": "T1",
   "sql": "SELECT category, name, units, n\nFROM (SELECT *, row_number() OVER (PARTITION BY category ORDER BY units DESC, id) AS n\n      FROM product_sales) AS ranked\nWHERE n <= 3\nORDER BY category, n",
   "note": "the three best sellers in every category, numbered within it.",
   "status": "ok",
