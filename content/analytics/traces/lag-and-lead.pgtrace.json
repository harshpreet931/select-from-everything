 "base": {"xid":799,"lsn":33646040},
 "setup": "CREATE VIEW monthly AS\nSELECT date_trunc('month', o.ordered_at)::date AS month,\n       sum(oi.qty * oi.unit_price) AS revenue\nFROM orders AS o\nJOIN order_items AS oi ON oi.order_id = o.id\nWHERE o.status NOT IN ('cancelled', 'refunded')\nGROUP BY 1;",
 "steps": [
  {
   "i": 0,
   "session": "T1",
   "sql": "SELECT month, revenue,\n       lag(month)   OVER w AS read_from,\n       lag(revenue) OVER w AS value\nFROM monthly\nWINDOW w AS (ORDER BY month)\nORDER BY month",
   "note": "lag(revenue) reads the row one before in the window's order: last month. july has no row before it, so it gets NULL.",
   "status": "ok",
   "result": {
