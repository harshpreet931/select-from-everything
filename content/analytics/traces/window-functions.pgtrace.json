   "session": "T1",
   "sql": "SELECT dept, count(*) AS people, round(avg(salary)) AS dept_avg\nFROM instructors\nGROUP BY dept\nORDER BY dept",
   "note": "GROUP BY dept: the eight instructors become four rows, one per department. the names are gone.",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 4,
    "columns": [{"name":"dept","type":"text"},{"name":"people","type":"int8"},{"name":"dept_avg","type":"numeric"}],
    "data": [["CS","4","88750"],["HIST","1","72000"],["MATH","2","84000"],["PHYS","1","90000"]]
   }
  },
  {
   "i": 1,
   "session": "T1",
   "sql": "SELECT name, dept, salary,\n       count(*) OVER (PARTITION BY dept) AS people,\n       round(avg(salary) OVER (PARTITION BY dept)) AS dept_avg\nFROM instructors\nORDER BY dept, salary DESC",
