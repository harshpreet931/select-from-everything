 "setup": "",
 "steps": [
  {
   "i": 0,
   "session": "T1",
   "sql": "SELECT name, salary FROM instructors ORDER BY salary, name",
   "note": "the eight instructors' salaries, in order.",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 8,
    "columns": [{"name":"name","type":"text"},{"name":"salary","type":"numeric"}],
    "data": [
     ["Oliver Grant","72000.00"],
     ["Sofia Petrova","79000.00"],
     ["Yuki Tanaka","83000.00"],
     ["Tomás Ortega","85000.00"],
     ["Lena Fischer","87000.00"],
     ["Amara Diallo","90000.00"],
     ["Marco Rossi","91000.00"],
     ["Hannah Okoye","98000.00"]
    ]
   }
  },
  {
   "i": 1,
   "session": "T1",
   "sql": "SELECT percentile_cont(ARRAY[0, 0.1, 0.2, 0.25, 0.3, 0.4, 0.5, 0.6, 0.7, 0.75, 0.8, 0.9, 1])\n         WITHIN GROUP (ORDER BY salary) AS cont,\n       percentile_disc(ARRAY[0, 0.1, 0.2, 0.25, 0.3, 0.4, 0.5, 0.6, 0.7, 0.75, 0.8, 0.9, 1])\n         WITHIN GROUP (ORDER BY salary) AS disc\nFROM instructors",
   "note": "both percentiles at eleven fractions, from 0 to 1, in one call each: they take an array of fractions and return an array of answers.",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 1,
    "columns": [{"name":"cont","type":"_float8"},{"name":"disc","type":"_numeric"}],
    "data": [
     [
      "{72000,76900,80600,82000,83200,84600,86000,87600,89700,90250,90600,93100,98000}",
      "{72000.00,72000.00,79000.00,79000.00,83000.00,85000.00,85000.00,87000.00,90000.00,90000.00,91000.00,98000.00,98000.00}"
     ]
    ]
   }
  },
  {
   "i": 2,
   "session": "T1",
   "sql": "SELECT dept, string_agg(name, ', ' ORDER BY name) AS instructors\nFROM instructors\nGROUP BY dept\nORDER BY dept",
   "note": "ORDER BY name inside the aggregate: each department's instructors, alphabetically.",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 4,
    "columns": [{"name":"dept","type":"text"},{"name":"instructors","type":"text"}],
    "data": [
     ["CS","Hannah Okoye, Lena Fischer, Marco Rossi, Sofia Petrova"],
     ["HIST","Oliver Grant"],
     ["MATH","Tomás Ortega, Yuki Tanaka"],
     ["PHYS","Amara Diallo"]
    ]
   }
  },
  {
   "i": 3,
   "session": "T1",
   "sql": "SELECT dept, string_agg(name, ', ' ORDER BY salary DESC) AS instructors\nFROM instructors\nGROUP BY dept\nORDER BY dept",
   "note": "ORDER BY salary DESC: the same people, best paid first. in CS, Marco Rossi moves ahead of Lena Fischer. the order inside the aggregate has nothing to do with the query's ORDER BY.",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 4,
    "columns": [{"name":"dept","type":"text"},{"name":"instructors","type":"text"}],
    "data": [
     ["CS","Hannah Okoye, Marco Rossi, Lena Fischer, Sofia Petrova"],
     ["HIST","Oliver Grant"],
     ["MATH","Tomás Ortega, Yuki Tanaka"],
     ["PHYS","Amara Diallo"]
    ]
   }
  },
  {
   "i": 4,
   "session": "T1",
   "sql": "SELECT dept, string_agg(DISTINCT credits::text, ', ' ORDER BY credits::text) AS credit_values\nFROM courses\nGROUP BY dept\nORDER BY dept",
   "note": "DISTINCT inside the aggregate: each department's credit values, once each. with DISTINCT, the ORDER BY may only use the aggregated expression.",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 5,
    "columns": [{"name":"dept","type":"text"},{"name":"credit_values","type":"text"}],
    "data": [["CS","4"],["GEN","6"],["HIST","3"],["MATH","3, 4"],["PHYS","4"]]
   }
  }
 ],
