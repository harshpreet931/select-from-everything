   "i": 0,
   "session": "T1",
   "sql": "SELECT category,\n       round(avg(price), 2) AS avg,\n       percentile_cont(0.5) WITHIN GROUP (ORDER BY price)::numeric(10,2) AS median\nFROM products\nWHERE category IS NOT NULL\nGROUP BY category\nORDER BY abs(avg(price) - percentile_cont(0.5) WITHIN GROUP (ORDER BY price)) DESC, category\nLIMIT 4",
   "note": "avg and median price per category, for the categories where they're furthest apart.",
   "status": "ok",
