      "db": "shop",
      "sql": "CREATE TABLE product_sales AS\nSELECT p.id, p.name, p.category, sum(oi.qty)::int AS units\nFROM products AS p\nJOIN order_items AS oi ON oi.product_id = p.id\nGROUP BY p.id;\nANALYZE product_sales;\n\nSELECT category, name, units\nFROM product_sales\nORDER BY units DESC, id\nLIMIT 3;",
