      "sql": "SELECT c.category, s.name, s.units\nFROM (SELECT DISTINCT category FROM product_sales) AS c\nCROSS JOIN LATERAL (\n  SELECT id, name, units FROM product_sales AS s\n  WHERE s.category = c.category\n  ORDER BY units DESC, id\n  LIMIT 3\n) AS s\nORDER BY c.category, s.units DESC, s.id\nLIMIT 6;",
