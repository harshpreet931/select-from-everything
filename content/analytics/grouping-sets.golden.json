    "8a0f48748ba1c53c": {
      "db": "shop",
      "sql": "SELECT CASE GROUPING(year, status)\n         WHEN 0 THEN 'detail' WHEN 1 THEN 'year total'\n         WHEN 2 THEN 'status total' ELSE 'grand total' END AS kind,\n       year, status, count(*) AS orders\nFROM (SELECT extract(year FROM ordered_at)::int AS year, status FROM orders) AS o\nGROUP BY CUBE (year, status)\nHAVING GROUPING(year, status) > 0\nORDER BY GROUPING(year, status), year, status;",
