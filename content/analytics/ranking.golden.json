    "7b9ee7a404c9f79d": {
      "db": "school",
      "sql": "CREATE VIEW gpa AS\nSELECT s.id, s.name,\n       round(avg(CASE e.grade WHEN 'A' THEN 4 WHEN 'B' THEN 3 WHEN 'C' THEN 2\n                              WHEN 'D' THEN 1 ELSE 0 END), 2) AS gpa\nFROM students AS s\nJOIN enrollments AS e ON e.student_id = s.id\nWHERE e.grade IS NOT NULL\nGROUP BY s.id;\n\nSELECT id, name, gpa,\n       row_number() OVER (ORDER BY gpa DESC, id) AS row_number,\n       rank()       OVER (ORDER BY gpa DESC)     AS rank,\n       dense_rank() OVER (ORDER BY gpa DESC)     AS dense_rank\nFROM gpa\nORDER BY gpa DESC, id\nLIMIT 8;",
