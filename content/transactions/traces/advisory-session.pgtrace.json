 "setup": "",
 "steps": [
  {
   "i": 0,
   "session": "T1",
   "sql": "BEGIN",
   "note": "T1 opens a transaction.",
   "status": "ok",
   "result": {"command":"BEGIN","rows":null,"columns":[],"data":[]},
   "locks": [{"session":"T1","type":"virtualxid","target":"4/4","mode":"ExclusiveLock","granted":true}]
  },
  {
   "i": 1,
   "session": "T1",
   "sql": "SELECT pg_advisory_lock(7)",
   "note": "T1 takes session-level advisory lock 7.",
   "status": "ok",
   "result": {"command":"SELECT","rows":1,"columns":[{"name":"pg_advisory_lock","type":"void"}],"data":[[""]]},
   "locks": [
    {"session":"T1","type":"advisory","target":"0:7:1","mode":"ExclusiveLock","granted":true},
    {"session":"T1","type":"virtualxid","target":"4/4","mode":"ExclusiveLock","granted":true}
   ]
  },
  {
   "i": 2,
   "session": "T1",
   "sql": "ROLLBACK",
   "note": "T1 rolls the transaction back. you'd think the lock goes with it.",
   "status": "ok",
   "result": {"command":"ROLLBACK","rows":null,"columns":[],"data":[]},
   "locks": [{"session":"T1","type":"advisory","target":"0:7:1","mode":"ExclusiveLock","granted":true}]
  },
  {
   "i": 3,
   "session": "T2",
   "sql": "SELECT pg_try_advisory_lock(7)",
   "note": "T2 tries for lock 7: false. T1's session still holds it, transaction or not.",
   "status": "ok",
   "result": {"command":"SELECT","rows":1,"columns":[{"name":"pg_try_advisory_lock","type":"bool"}],"data":[["f"]]},
   "locks": [{"session":"T1","type":"advisory","target":"0:7:1","mode":"ExclusiveLock","granted":true}]
  },
  {
   "i": 4,
   "session": "T1",
   "sql": "SELECT pg_advisory_unlock(7)",
   "note": "only an explicit unlock (or the session ending) lets it go.",
   "status": "ok",
   "result": {"command":"SELECT","rows":1,"columns":[{"name":"pg_advisory_unlock","type":"bool"}],"data":[["t"]]},
   "locks": []
  },
  {
   "i": 5,
   "session": "T2",
   "sql": "SELECT pg_try_advisory_lock(7)",
   "note": "now T2 gets it.",
   "status": "ok",
   "result": {"command":"SELECT","rows":1,"columns":[{"name":"pg_try_advisory_lock","type":"bool"}],"data":[["t"]]},
   "locks": [{"session":"T2","type":"advisory","target":"0:7:1","mode":"ExclusiveLock","granted":true}]
  }
 ]
