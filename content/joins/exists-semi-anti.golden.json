    "f6b15f20e25aea51": {
      "db": "school",
      "sql": "SELECT s.id, s.name\nFROM students AS s\nJOIN enrollments AS e ON e.student_id = s.id\nJOIN courses AS c ON c.code = e.course_code\nWHERE c.dept = 'CS'\nGROUP BY s.id\nHAVING count(DISTINCT c.code) = (SELECT count(*) FROM courses WHERE dept = 'CS')\nORDER BY s.id;",
