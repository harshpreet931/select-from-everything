  {
   "i": 5,
   "session": "T1",
   "sql": "SELECT c.id, c.name, o.id AS order_id, o.day\nFROM customers AS c\nLEFT JOIN LATERAL (\n  SELECT o.id, o.ordered_at::date AS day\n  FROM orders AS o\n  WHERE o.customer_id = c.id\n  ORDER BY o.ordered_at DESC\n  LIMIT 3\n) AS o ON true\nWHERE c.id IN (1, 7, 42)\nORDER BY c.id, o.day DESC, o.id DESC",
   "note": "LEFT JOIN LATERAL ... ON true: same subqueries, but a customer whose subquery returned nothing comes back once, padded. Ming Li is back.",
