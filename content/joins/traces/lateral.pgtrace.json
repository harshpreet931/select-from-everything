  {
   "i": 0,
   "session": "T1",
   "sql": "SELECT id, name FROM customers WHERE id IN (1, 7, 42) ORDER BY id",
   "note": "the left side: three customers.",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 3,
    "columns": [{"name":"id","type":"int4"},{"name":"name","type":"text"}],
