   "sql": "SELECT o.id, o.status, o.ordered_at::date AS day\nFROM orders AS o\nWHERE o.customer_id = 42\nORDER BY o.ordered_at DESC\nLIMIT 3",
   "note": "for Ada, c.id = 42: three of her seven orders.",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 3,
    "columns": [{"name":"id","type":"int4"},{"name":"status","type":"text"},{"name":"day","type":"date"}],
    "data": [["9946","placed","2026-06-25"],["9615","delivered","2026-06-13"],["8219","delivered","2026-04-23"]]
   }
  },
  {
   "i": 4,
   "session": "T1",
   "sql": "SELECT c.id, c.name, o.id AS order_id, o.day\nFROM customers AS c\nCROSS JOIN LATERAL (\n  SELECT o.id, o.ordered_at::date AS day\n  FROM orders AS o\n  WHERE o.customer_id = c.id\n  ORDER BY o.ordered_at DESC\n  LIMIT 3\n) AS o\nWHERE c.id IN (1, 7, 42)\nORDER BY c.id, o.day DESC, o.id DESC",
   "note": "CROSS JOIN LATERAL: each customer joined to whatever their subquery returned. Ming Li's returned nothing, so she has no rows here, like an inner join.",
