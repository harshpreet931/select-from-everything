   }
  },
  {
   "i": 1,
   "session": "T1",
   "sql": "SELECT o.id, o.status, o.ordered_at::date AS day\nFROM orders AS o\nWHERE o.customer_id = 1\nORDER BY o.ordered_at DESC\nLIMIT 3",
   "note": "for Maya Chen, the subquery runs with c.id = 1: her three latest orders, out of 57.",
   "status": "ok",
   "result": {
