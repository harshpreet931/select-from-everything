   "sql": "SELECT c.name, o.id AS order_id, oi.line_no, oi.product_id, oi.qty\nFROM customers AS c\nJOIN orders AS o ON o.customer_id = c.id\nJOIN order_items AS oi ON oi.order_id = o.id\nWHERE c.id = 42\nORDER BY o.id, oi.line_no",
