  {
   "i": 0,
   "session": "T1",
   "sql": "SELECT c.id, c.name\nFROM customers AS c\nWHERE c.id = 42",
   "note": "customers, narrowed to one row: Ada Lovelace, customer 42.",
   "status": "ok",
   "result": {
    "command": "SELECT",
    "rows": 1,
    "columns": [{"name":"id","type":"int4"},{"name":"name","type":"text"}],
    "data": [["42","Ada Lovelace"]]
   }
  },
  {
   "i": 1,
   "session": "T1",
   "sql": "SELECT c.name, o.id AS order_id, o.status\nFROM customers AS c\nJOIN orders AS o ON o.customer_id = c.id\nWHERE c.id = 42\nORDER BY o.id",
   "note": "join orders: one row per order of hers. Ada's row is repeated 7 times, once for each.",
   "status": "ok",
   "result": {
