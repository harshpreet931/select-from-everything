 "setup": "",
 "steps": [
  {
   "i": 0,
   "session": "T1",
   "sql": "SELECT count(*) FROM products",
   "note": "how many products.",
   "status": "ok",
   "result": {"command":"SELECT","rows":1,"columns":[{"name":"count","type":"int8"}],"data":[["200"]]}
  },
  {
   "i": 1,
   "session": "T1",
   "sql": "SELECT count(*) FROM order_items",
   "note": "how many order lines.",
   "status": "ok",
   "result": {"command":"SELECT","rows":1,"columns":[{"name":"count","type":"int8"}],"data":[["24942"]]}
  },
  {
   "i": 2,
   "session": "T1",
   "sql": "SELECT count(*) FROM products AS p JOIN order_items AS oi ON oi.product_id = p.id",
   "note": "INNER JOIN: one row per (product, order line) pair that matches. every line has a product.",
   "status": "ok",
   "result": {"command":"SELECT","rows":1,"columns":[{"name":"count","type":"int8"}],"data":[["24942"]]}
  },
  {
   "i": 3,
   "session": "T1",
   "sql": "SELECT count(*) FROM products AS p LEFT JOIN order_items AS oi ON oi.product_id = p.id",
   "note": "LEFT JOIN: every matching pair, plus each product that matched nothing (the teapot), padded with NULLs.",
   "status": "ok",
   "result": {"command":"SELECT","rows":1,"columns":[{"name":"count","type":"int8"}],"data":[["24943"]]}
  },
  {
   "i": 4,
   "session": "T1",
   "sql": "SELECT count(*) FROM products AS p FULL JOIN order_items AS oi ON oi.product_id = p.id",
   "note": "FULL JOIN: the same here. a foreign key means no order line is ever without its product.",
   "status": "ok",
   "result": {"command":"SELECT","rows":1,"columns":[{"name":"count","type":"int8"}],"data":[["24943"]]}
  },
  {
   "i": 5,
   "session": "T1",
   "sql": "SELECT count(*) FROM (SELECT id FROM products INTERSECT SELECT product_id FROM order_items) AS x",
   "note": "INTERSECT: the product ids that appear on both sides, once each. this is what the overlap actually draws.",
   "status": "ok",
   "result": {"command":"SELECT","rows":1,"columns":[{"name":"count","type":"int8"}],"data":[["199"]]}
  },
  {
   "i": 6,
   "session": "T1",
   "sql": "SELECT count(*) FROM (SELECT id FROM products EXCEPT SELECT product_id FROM order_items) AS x",
   "note": "EXCEPT: product ids with no order line at all. just one: the left-handed teapot.",
   "status": "ok",
   "result": {"command":"SELECT","rows":1,"columns":[{"name":"count","type":"int8"}],"data":[["1"]]}
  },
  {
   "i": 7,
   "session": "T1",
   "sql": "SELECT count(*) FROM (SELECT id FROM products UNION SELECT product_id FROM order_items) AS x",
   "note": "UNION: every product id from either side, once. order lines can't add a new one.",
   "status": "ok",
   "result": {"command":"SELECT","rows":1,"columns":[{"name":"count","type":"int8"}],"data":[["200"]]}
  }
 ],
