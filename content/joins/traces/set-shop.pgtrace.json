   "sql": "SELECT count(*) AS customers FROM (\n  SELECT customer_id FROM orders WHERE ordered_at < timestamptz '2026-01-01 00:00+00'\n  UNION\n  SELECT customer_id FROM orders WHERE ordered_at >= timestamptz '2026-01-01 00:00+00'\n) AS x",
   "note": "UNION: customers who ordered in either year, each once. that's every customer who ever ordered.",
   "status": "ok",
   "result": {"command":"SELECT","rows":1,"columns":[{"name":"customers","type":"int8"}],"data":[["1962"]]}
