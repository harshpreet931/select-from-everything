{
  "name": "select-star-from-everything",
  "version": "0.1.0",
  "private": true,
  "description": "select * from everything: sql and databases, all the way down. a free, visual-first book with a real postgres in the browser.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/sql-assets.mjs && next dev",
    "build": "node scripts/sql-assets.mjs && next build && pagefind --site out --output-subdir _pagefind",
    "start": "npx serve out",
    "check": "node scripts/check.mjs",
    "sql-assets": "node scripts/sql-assets.mjs",
    "sql-check": "node scripts/sql-check.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "test:sim": "node --experimental-strip-types --test \"src/lib/db/sim/*.test.ts\"",
    "dev:poll": "node scripts/sql-assets.mjs && WATCHPACK_POLLING=true next dev --webpack",
    "pgtrace": "node tools/pgtrace/pgtrace.mjs",
    "indexnow": "node scripts/indexnow.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.4.3",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "@codemirror/lang-sql": "6.10.0",
    "@electric-sql/pglite": "0.5.12"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@shikijs/transformers": "4.5.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/hast": "^3.0.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "estree-util-value-to-estree": "^3.5.0",
    "github-slugger": "^2.0.0",
    "hast-util-to-html": "^9.0.5",
    "hast-util-to-string": "^3.0.1",
    "mdast-util-to-string": "^4.0.0",
    "pagefind": "1.5.2",
    "rehype-pretty-code": "0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "shiki": "4.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3",
    "unist-util-visit": "^5.1.0",
    "pg": "8.23.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide",
      "sharp"
    ]
  }
}
